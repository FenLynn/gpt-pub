<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LocalSub</AssemblyName>
    <RootNamespace>LocalSub</RootNamespace>
    <Version>0.1.4</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.4" />
  </ItemGroup>
  <ItemGroup>
    <!-- Heavy background and realtime implementations are compiled only into LocalSub.Core.exe. -->
    <Compile Remove="Services\BatchTranscriptionService.cs" />
    <Compile Remove="Services\ModelManager.cs" />
    <Compile Remove="Services\MediaAnalysisService.cs" />
    <Compile Remove="Services\AllAudioCaptureService.cs" />
    <Compile Remove="Services\ResilientPotPlayerCaptureService.cs" />
    <Compile Remove="Services\ProcessLoopbackCaptureService.cs" />
    <Compile Remove="Services\StreamingParaformerService.cs" />
    <Compile Remove="Services\SenseVoiceSimulatedStreamingService.cs" />
    <Compile Remove="Services\FunAsrNanoSimulatedStreamingService.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\subtitle.html"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Assets\model-catalog.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
  </ItemGroup>
  <ItemGroup Condition="Exists('WebUi\dist\index.html')">
    <EmbeddedResource Include="WebUi\dist\index.html" LogicalName="LocalSub.WebUi.index.html" />
    <EmbeddedResource Include="WebUi\dist\assets\app.js" LogicalName="LocalSub.WebUi.assets.app.js" />
    <EmbeddedResource Include="WebUi\dist\assets\app.css" LogicalName="LocalSub.WebUi.assets.app.css" />
  </ItemGroup>
  <Target Name="ValidateWebUiBundleForPublish" BeforeTargets="Publish">
    <Error Condition="!Exists('WebUi\dist\index.html') Or !Exists('WebUi\dist\assets\app.js') Or !Exists('WebUi\dist\assets\app.css')"
           Text="LocalSub WebUi production bundle is missing. Run npm install and npm run build in src/LocalSub/WebUi before dotnet publish." />
  </Target>
</Project>
