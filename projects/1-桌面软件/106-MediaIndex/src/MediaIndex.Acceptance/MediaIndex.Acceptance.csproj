<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MediaIndex.Acceptance</AssemblyName>
    <RootNamespace>MediaIndex.Acceptance</RootNamespace>
    <Version>0.0.3</Version>
    <FileVersion>0.0.3.0</FileVersion>
    <Product>MediaIndex Acceptance</Product>
    <Company>FenLynn</Company>
    <Description>Real domain acceptance tool for MediaIndex P106</Description>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <ApplicationIcon Condition="Exists('$(MSBuildProjectDirectory)\MediaIndex.Acceptance.ico')">MediaIndex.Acceptance.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource
      Include="Generated\MediaIndex.Acceptance.Worker.exe"
      LogicalName="MediaIndex.Acceptance.Worker.exe"
      Condition="Exists('$(MSBuildProjectDirectory)\Generated\MediaIndex.Acceptance.Worker.exe')" />
  </ItemGroup>
</Project>
