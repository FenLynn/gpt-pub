{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodexHandoff",
  "version": "1.0.0-alpha.4",
  "identifier": "com.fenlynn.codexhandoff",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CodexHandoff 1.0.0 alpha 4",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false }
}
