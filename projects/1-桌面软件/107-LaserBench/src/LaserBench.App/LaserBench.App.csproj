<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>LaserBench.App</AssemblyName>
    <RootNamespace>LaserBench</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <ApplicationIcon>LaserBench.ico</ApplicationIcon>
  </PropertyGroup>
  <Target Name="GenerateLaserBenchIcon" BeforeTargets="PrepareForBuild">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\Build\GenerateAppIcon.ps1&quot; -OutputPath &quot;$(MSBuildProjectDirectory)\LaserBench.ico&quot;" />
  </Target>
  <Target Name="CleanGeneratedLaserBenchIcon" AfterTargets="Build;Publish">
    <Delete Files="$(MSBuildProjectDirectory)\LaserBench.ico" />
  </Target>
</Project>
