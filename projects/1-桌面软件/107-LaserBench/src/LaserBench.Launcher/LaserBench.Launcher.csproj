<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>LaserBench</AssemblyName>
    <RootNamespace>LaserBench.Launcher</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <ApplicationIcon>LaserBench.ico</ApplicationIcon>
  </PropertyGroup>
  <Target Name="GenerateLaserBenchIcon" BeforeTargets="PrepareForBuild">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\Build\GenerateAppIcon.ps1&quot; -OutputPath &quot;$(MSBuildProjectDirectory)\LaserBench.ico&quot;" />
  </Target>
  <Target Name="CleanGeneratedLaserBenchIcon" AfterTargets="Build;Publish">
    <Delete Files="$(MSBuildProjectDirectory)\LaserBench.ico" />
  </Target>
</Project>
