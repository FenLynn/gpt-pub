<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\personal-workbench-native\PersonalWorkbench.csproj" />
    <ProjectReference Include="..\personal-workbench-residency-smoke\AtlasDesk.ResidencySmoke.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="RunAtlasDeskResidencySmoke"
          AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true'">
    <Exec Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)..\personal-workbench-residency-smoke\AtlasDesk.ResidencySmoke.csproj&quot; --configuration $(Configuration) --no-build --no-restore" />
  </Target>
</Project>
