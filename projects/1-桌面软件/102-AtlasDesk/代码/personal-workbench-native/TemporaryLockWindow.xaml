<Window x:Class="PersonalWorkbench.TemporaryLockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AtlasDesk 已临时锁定" Width="480" Height="300"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="#F4F7FB" FontFamily="{StaticResource AppFont}">
    <Border Margin="10" Background="White" BorderBrush="#DDE5EF" BorderThickness="1" CornerRadius="18" Padding="28">
        <StackPanel VerticalAlignment="Center">
            <Border Width="54" Height="54" CornerRadius="17" Background="#EAF2FF" HorizontalAlignment="Center">
                <Viewbox Width="25" Height="25">
                    <Path Data="M7,10 V7 C7,4.8 8.8,3 11,3 H13 C15.2,3 17,4.8 17,7 V10 M5,10 H19 V21 H5 Z M12,14 V17"
                          Stroke="#3F7FEA" StrokeThickness="1.8" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Viewbox>
            </Border>
            <TextBlock Text="AtlasDesk 已临时锁定" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4"/>
            <TextBlock Text="输入四位数字继续。它只用于临时遮挡界面，不参与数据加密。" FontSize="11.7" Foreground="#718197" TextAlignment="Center" TextWrapping="Wrap"/>
            <PasswordBox x:Name="PinBox" Width="180" Height="38" MaxLength="4" HorizontalAlignment="Center" Margin="0,18,0,0" Padding="10,5" KeyDown="PinBox_KeyDown"/>
            <Button Content="解锁" Style="{StaticResource PrimaryButton}" Width="180" HorizontalAlignment="Center" Margin="0,12,0,0" Click="Unlock_Click"/>
            <TextBlock x:Name="StatusText" Foreground="#B1464F" FontSize="11.5" HorizontalAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>
    </Border>
</Window>
