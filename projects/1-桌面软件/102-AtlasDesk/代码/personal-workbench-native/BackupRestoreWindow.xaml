<Window x:Class="PersonalWorkbench.BackupRestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="备份与迁移" Width="820" Height="600" MinWidth="680" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="#F4F7FB" FontFamily="{StaticResource AppFont}">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="备份与迁移" Style="{StaticResource PageHeading}"/>
                <TextBlock Text="仅迁移设置和任务历史；登录会话、浏览器资料、缓存与日志不会进入备份。" Style="{StaticResource PageDescription}"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#EAF2FF" CornerRadius="9" Padding="10,6" VerticalAlignment="Center">
                <TextBlock x:Name="VersionText" Foreground="#326FD6" FontSize="10.8" FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource ToolbarCard}" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button x:Name="ExportButton" Content="导出备份" Style="{StaticResource PrimaryButton}" Click="Export_Click"/>
                <Button x:Name="ValidateButton" Grid.Column="2" Content="检查备份" Style="{StaticResource SecondaryButton}" Click="Validate_Click"/>
                <Button x:Name="RestoreButton" Grid.Column="4" Content="恢复备份" Style="{StaticResource SecondaryButton}" Click="Restore_Click"/>
                <TextBlock Grid.Column="5" Text="恢复后需要重启工作台，当前窗口中的旧配置不会被强行覆盖。" FontSize="10.8" Foreground="#718198" VerticalAlignment="Center" Margin="14,0,0,0"/>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource SurfaceCard}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="备份边界" FontSize="14" FontWeight="SemiBold"/>
                    <StackPanel Grid.Row="2">
                        <Border Background="#E7F7F0" CornerRadius="9" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="会包含" Foreground="#187A58" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="settings.json · task-history.json" FontSize="12.2" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#FDEAEA" CornerRadius="9" Padding="10,8" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="绝不包含" Foreground="#B13D48" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="WebView2Profile、BrowserProfile、Access/GitHub 登录、Cookie、日志、缓存、终端资产和启动状态" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Row="4" Text="安全机制" FontSize="14" FontWeight="SemiBold"/>
                    <StackPanel Grid.Row="6">
                        <TextBlock Text="• 备份文件逐项 SHA-256 校验" FontSize="11.8" Margin="0,0,0,5"/>
                        <TextBlock Text="• 严格文件白名单与路径穿越拦截" FontSize="11.8" Margin="0,0,0,5"/>
                        <TextBlock Text="• 解压大小、条目数和单文件大小限制" FontSize="11.8" Margin="0,0,0,5"/>
                        <TextBlock Text="• 恢复前自动创建当前配置快照" FontSize="11.8" Margin="0,0,0,5"/>
                        <TextBlock Text="• 原子写入；失败时尝试回滚已写文件" FontSize="11.8"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SurfaceCard}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="ResultTitle" Text="等待操作" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ResultSubtitle" Text="可先导出备份，或检查已有 .pwbak 文件。" FontSize="10.8" Foreground="#738298" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ProgressBar x:Name="OperationProgress" Grid.Row="2" Height="5" IsIndeterminate="False"/>
                    <Border Grid.Row="4" Background="#F7F9FC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="9" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="ResultText" Text="无结果" FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" FontSize="11.3" Foreground="#43556D" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="OpenFolderButton" Content="打开所在目录" Style="{StaticResource SecondaryButton}" IsEnabled="False" Click="OpenFolder_Click"/>
                        <Button x:Name="CopyButton" Content="复制结果" Style="{StaticResource SecondaryButton}" IsEnabled="False" Margin="7,0,0,0" Click="Copy_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="6" x:Name="StatusText" Text="配置目录：%APPDATA%\PersonalWorkbench" FontSize="10.8" Foreground="#718198" TextTrimming="CharacterEllipsis"/>
    </Grid>
</Window>
