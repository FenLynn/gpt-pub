<UserControl x:Class="PersonalWorkbench.HomeDashboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource SurfaceCard}">
            <Setter Property="Padding" Value="14,12"/><Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="QuickAction" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Height" Value="31"/><Setter Property="MinWidth" Value="0"/><Setter Property="Padding" Value="12,0"/><Setter Property="Margin" Value="0,0,7,0"/><Setter Property="FontSize" Value="11.8"/>
        </Style>
        <Style x:Key="RecentRow" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,1"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F0F5FB"/></Trigger></Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18,14,18,18">
        <Grid.RowDefinitions><RowDefinition Height="136"/><RowDefinition Height="11"/><RowDefinition Height="96"/><RowDefinition Height="11"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" CornerRadius="17" ClipToBounds="True">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E9F3FF" Offset="0"/><GradientStop Color="#F1EDFF" Offset="0.58"/><GradientStop Color="#E9F8F5" Offset="1"/></LinearGradientBrush></Border.Background>
            <Grid>
                <Ellipse Width="250" Height="250" Fill="#4A86F718" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-110,-50,0"/>
                <Grid Margin="21,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="GreetingText" Text="早上好，Fenlynn" FontSize="22" FontWeight="SemiBold" Foreground="#17243A"/>
                        <TextBlock Text="从上次的位置继续，或直接进入今天的工作。" FontSize="12.2" Foreground="#64758D" Margin="0,5,0,12"/>
                        <StackPanel Orientation="Horizontal"><Button Content="打开 Dashboard" Style="{StaticResource PrimaryButton}" Height="32" Click="OpenDashboard_Click"/><Button Content="全局搜索" Style="{StaticResource QuickAction}" Margin="8,0,0,0" Click="GlobalSearch_Click"/><Button Content="新建终端" Style="{StaticResource QuickAction}" Click="OpenTerminal_Click"/></StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#FFFFFFA8" BorderBrush="#FFFFFFD8" BorderThickness="1" CornerRadius="13" Padding="13,10" VerticalAlignment="Center">
                        <StackPanel><TextBlock Text="当前工作区" FontSize="10.3" Foreground="#76869B"/><TextBlock x:Name="WorkspaceNameText" Text="尚未配置" FontSize="13.8" FontWeight="SemiBold" Margin="0,3,0,1" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="WorkspacePathText" Text="在设置中选择目录" FontSize="10.2" Foreground="#7C899A" TextTrimming="CharacterEllipsis"/><Button Content="进入工作区" Style="{StaticResource SecondaryButton}" Height="27" MinWidth="0" Margin="0,7,0,0" Click="OpenWorkspace_Click"/></StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="2" Columns="4">
            <Border Style="{StaticResource MetricCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="35"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="29" Height="29" CornerRadius="8" Background="#EAF2FF"><TextBlock Text="D" Foreground="#3678E7" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Dashboard" FontSize="10.3" Foreground="#7C899B"/><TextBlock x:Name="DashboardValue" Text="未配置" FontSize="13.5" FontWeight="SemiBold" Margin="0,1,0,0"/><TextBlock x:Name="DashboardDetail" Text="Cloudflare Pages" FontSize="9.8" Foreground="#8B98A8" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></Border>
            <Border Style="{StaticResource MetricCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="35"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="29" Height="29" CornerRadius="8" Background="#F0ECFF"><TextBlock Text="Z" Foreground="#765BD1" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Zotero" FontSize="10.3" Foreground="#7C899B"/><TextBlock x:Name="ZoteroValue" Text="未连接" FontSize="13.5" FontWeight="SemiBold" Margin="0,1,0,0"/><TextBlock x:Name="ZoteroDetail" Text="只读文献库" FontSize="9.8" Foreground="#8B98A8"/></StackPanel></Grid></Border>
            <Border Style="{StaticResource MetricCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="35"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="29" Height="29" CornerRadius="8" Background="#E8F8F3"><TextBlock Text="Py" Foreground="#158B69" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Python" FontSize="10.3" Foreground="#7C899B"/><TextBlock x:Name="PythonValue" Text="待检测" FontSize="13.5" FontWeight="SemiBold" Margin="0,1,0,0"/><TextBlock x:Name="PythonDetail" Text="Conda / uv" FontSize="9.8" Foreground="#8B98A8"/></StackPanel></Grid></Border>
            <Border Style="{StaticResource MetricCard}" Margin="0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="35"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="29" Height="29" CornerRadius="8" Background="#FFF2E7"><TextBlock Text="F" Foreground="#CD7225" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="工作区" FontSize="10.3" Foreground="#7C899B"/><TextBlock x:Name="WorkspaceValue" Text="0 个最近文件" FontSize="13.5" FontWeight="SemiBold" Margin="0,1,0,0"/><TextBlock x:Name="WorkspaceDetail" Text="Markdown / 代码 / PDF" FontSize="9.8" Foreground="#8B98A8"/></StackPanel></Grid></Border>
        </UniformGrid>

        <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="11"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource SurfaceCard}" Padding="14,11"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Text="最近文件" FontSize="13.8" FontWeight="SemiBold"/><Button Content="查看工作区" Style="{StaticResource TextButton}" HorizontalAlignment="Right" Click="OpenWorkspace_Click"/></Grid><ItemsControl x:Name="RecentFilesList" Grid.Row="1" Margin="0,7,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource RecentRow}" Cursor="Hand" MouseLeftButtonUp="RecentFile_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="23" Height="23" CornerRadius="7" Background="#EEF3FA"><TextBlock Text="•" FontSize="16" Foreground="#5279B6" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontSize="11.8" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding DirectoryName}" FontSize="9.6" Foreground="#8A97A7" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></Border>
            <Border Grid.Column="2" Style="{StaticResource SurfaceCard}" Padding="14,11"><StackPanel><TextBlock Text="快速开始" FontSize="13.8" FontWeight="SemiBold"/><TextBlock Text="把高频动作集中到一个位置。" FontSize="10.3" Foreground="#8190A4" Margin="0,3,0,9"/><Button Content="搜索 Zotero 文献" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Margin="0,0,0,6" Click="OpenLibrary_Click"/><Button Content="查看 Python 环境" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Margin="0,0,0,6" Click="OpenDevelopment_Click"/><Button Content="打开设置中心" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Click="OpenSettings_Click"/></StackPanel></Border>
        </Grid>
    </Grid>
</UserControl>
