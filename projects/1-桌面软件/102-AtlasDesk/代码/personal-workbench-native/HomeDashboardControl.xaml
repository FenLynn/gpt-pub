<UserControl x:Class="PersonalWorkbench.HomeDashboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="HomeMetricCard" TargetType="Border" BasedOn="{StaticResource SurfaceCard}">
            <Setter Property="Padding" Value="15,13"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="MinHeight" Value="86"/>
        </Style>
        <Style x:Key="HomeQuickButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="FontSize" Value="11.8"/>
        </Style>
        <Style x:Key="HomeRecentRow" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Margin" Value="0,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF4FB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="18,14,18,20" MinWidth="760">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" MinHeight="166" CornerRadius="18" ClipToBounds="True" BorderBrush="#DDE8F5" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#E8F2FF" Offset="0"/>
                        <GradientStop Color="#F3EEFF" Offset="0.55"/>
                        <GradientStop Color="#EAF8F4" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Ellipse Width="330" Height="330" Fill="#FFFFFF70" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-175,-70,0"/>
                    <Ellipse Width="190" Height="190" Fill="#5C8CF211" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-85,0,0,-105"/>
                    <Grid Margin="23,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="310"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="PERSONAL WORKBENCH  ·  TODAY" FontSize="9.8" FontWeight="SemiBold" Foreground="#6E7F97"/>
                            <TextBlock x:Name="GreetingText" Text="早上好，Fenlynn" FontSize="24" FontWeight="SemiBold" Foreground="#18263B" Margin="0,5,0,0"/>
                            <TextBlock x:Name="DateText" Text="今天" FontSize="11.3" Foreground="#65768E" Margin="0,4,0,13"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="继续工作" Style="{StaticResource PrimaryButton}" Height="33" Click="OpenWorkspace_Click"/>
                                <Button Content="全局搜索" Style="{StaticResource HomeQuickButton}" Margin="8,0,0,0" Click="GlobalSearch_Click"/>
                                <Button Content="新建终端" Style="{StaticResource HomeQuickButton}" Click="OpenTerminal_Click"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="2" Background="#FFFFFFC4" BorderBrush="#FFFFFFEE" BorderThickness="1" CornerRadius="14" Padding="15,13" VerticalAlignment="Center">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Text="当前上下文" FontSize="10.4" Foreground="#76869A"/>
                                    <Border HorizontalAlignment="Right" Background="#EAF6F1" CornerRadius="7" Padding="7,2">
                                        <TextBlock Text="本地" FontSize="9.5" Foreground="#2F7E60"/>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="WorkspaceNameText" Grid.Row="1" Text="尚未配置" FontSize="15" FontWeight="SemiBold" Foreground="#26384F" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="WorkspacePathText" Grid.Row="2" Text="在设置中选择目录" FontSize="10.4" Foreground="#748399" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="进入工作区" Style="{StaticResource SecondaryButton}" Height="28" MinWidth="0" Padding="12,0" Click="OpenWorkspace_Click"/>
                                    <Button Content="Dashboard" Style="{StaticResource TextButton}" Margin="8,0,0,0" Click="OpenDashboard_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <UniformGrid Grid.Row="2" Columns="4">
                <Border Style="{StaticResource HomeMetricCard}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="9" Background="#EAF2FF"><TextBlock Text="D" Foreground="#3678E7" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Grid.Column="1"><TextBlock Text="DASHBOARD" FontSize="9.4" FontWeight="SemiBold" Foreground="#8491A3"/><TextBlock x:Name="DashboardValue" Text="未配置" FontSize="14" FontWeight="SemiBold" Foreground="#2A3B52" Margin="0,3,0,0"/><TextBlock x:Name="DashboardDetail" Text="Cloudflare Pages" FontSize="9.8" Foreground="#8B98A8" TextTrimming="CharacterEllipsis"/></StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource HomeMetricCard}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="9" Background="#F0ECFF"><TextBlock Text="Z" Foreground="#765BD1" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Grid.Column="1"><TextBlock Text="ZOTERO" FontSize="9.4" FontWeight="SemiBold" Foreground="#8491A3"/><TextBlock x:Name="ZoteroValue" Text="未连接" FontSize="14" FontWeight="SemiBold" Foreground="#2A3B52" Margin="0,3,0,0"/><TextBlock x:Name="ZoteroDetail" Text="只读文献库" FontSize="9.8" Foreground="#8B98A8" TextTrimming="CharacterEllipsis"/></StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource HomeMetricCard}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="9" Background="#E8F8F3"><TextBlock Text="Py" Foreground="#158B69" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Grid.Column="1"><TextBlock Text="PYTHON" FontSize="9.4" FontWeight="SemiBold" Foreground="#8491A3"/><TextBlock x:Name="PythonValue" Text="待检测" FontSize="14" FontWeight="SemiBold" Foreground="#2A3B52" Margin="0,3,0,0"/><TextBlock x:Name="PythonDetail" Text="Conda / uv" FontSize="9.8" Foreground="#8B98A8" TextTrimming="CharacterEllipsis"/></StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource HomeMetricCard}" Margin="0">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="9" Background="#FFF2E7"><TextBlock Text="W" Foreground="#CD7225" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Grid.Column="1"><TextBlock Text="WORKSPACE" FontSize="9.4" FontWeight="SemiBold" Foreground="#8491A3"/><TextBlock x:Name="WorkspaceValue" Text="0 个最近文件" FontSize="14" FontWeight="SemiBold" Foreground="#2A3B52" Margin="0,3,0,0"/><TextBlock x:Name="WorkspaceDetail" Text="Markdown / 代码 / 图片" FontSize="9.8" Foreground="#8B98A8" TextTrimming="CharacterEllipsis"/></StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource SurfaceCard}" Padding="15,12" MinHeight="248">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="最近工作" FontSize="14.2" FontWeight="SemiBold"/><TextBlock Text="  ·  从上次的位置继续" FontSize="10.5" Foreground="#8B98A8" VerticalAlignment="Center"/></StackPanel>
                            <Button Content="查看工作区" Style="{StaticResource TextButton}" HorizontalAlignment="Right" Click="OpenWorkspace_Click"/>
                        </Grid>
                        <ItemsControl x:Name="RecentFilesList" Grid.Row="1" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource HomeRecentRow}" Cursor="Hand" MouseLeftButtonUp="RecentFile_Click" ToolTip="{Binding FullPath}">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="31"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Width="25" Height="25" CornerRadius="7" Background="#EEF3FA"><TextBlock Text="•" FontSize="17" Foreground="#5279B6" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                            <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontSize="11.9" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding DirectoryName}" FontSize="9.6" Foreground="#8A97A7" TextTrimming="CharacterEllipsis"/></StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource SurfaceCard}" Padding="15,12" MinHeight="248">
                    <StackPanel>
                        <TextBlock Text="快捷入口" FontSize="14.2" FontWeight="SemiBold"/>
                        <TextBlock Text="常用动作保持在首页，不必先进入模块再寻找按钮。" FontSize="10.4" Foreground="#8190A4" Margin="0,4,0,11" TextWrapping="Wrap"/>
                        <Button Content="搜索 Zotero 文献" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Height="34" Margin="0,0,0,7" Click="OpenLibrary_Click"/>
                        <Button Content="查看 Python 与开发环境" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Height="34" Margin="0,0,0,7" Click="OpenDevelopment_Click"/>
                        <Button Content="打开 Cloudflare Dashboard" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Height="34" Margin="0,0,0,7" Click="OpenDashboard_Click"/>
                        <Button Content="设置与数据迁移" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Height="34" Click="OpenSettings_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="6" Background="#F7F9FC" BorderBrush="#E3E9F1" BorderThickness="1" CornerRadius="11" Padding="12,8">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="本地优先 · 工作区、Zotero 与环境状态只在本机读取" FontSize="10.4" Foreground="#78879A"/>
                    <TextBlock Grid.Column="1" Text="AtlasDesk" FontSize="10.2" Foreground="#9AA5B4"/>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
