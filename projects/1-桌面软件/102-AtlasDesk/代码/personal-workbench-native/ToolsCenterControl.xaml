<UserControl x:Class="PersonalWorkbench.ToolsCenterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="文件完整性" Style="{StaticResource PageHeading}"/>
                <TextBlock Text="生成和验证 SHA-256 清单，或比较两个文件；只读取原文件，不执行任何内容。" Style="{StaticResource PageDescription}"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#EAF2FF" CornerRadius="9" Padding="10,6" VerticalAlignment="Center">
                <TextBlock x:Name="WorkspaceBadgeText" Text="未配置工作区" Foreground="#326FD6" FontSize="10.8" FontWeight="SemiBold" MaxWidth="330" TextTrimming="CharacterEllipsis"/>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource ToolbarCard}" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="GenerateButton" Content="生成工作区清单" Style="{StaticResource PrimaryButton}" Click="Generate_Click"/>
                <Button x:Name="VerifyButton" Grid.Column="2" Content="验证清单" Style="{StaticResource SecondaryButton}" Click="Verify_Click"/>
                <Button x:Name="CompareButton" Grid.Column="4" Content="比较两个文件" Style="{StaticResource SecondaryButton}" Click="Compare_Click"/>
                <Button x:Name="CancelButton" Grid.Column="6" Content="取消当前操作" Style="{StaticResource SecondaryButton}" IsEnabled="False" Click="Cancel_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource SurfaceCard}" Padding="8">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="ResultTitle" Text="验证结果" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="ResultCountText" FontSize="10.8" Foreground="#708097" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Row="2">
                        <ListView x:Name="VerificationList" BorderThickness="0" Background="Transparent" SelectionChanged="VerificationList_SelectionChanged">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="状态" Width="90">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding StatusBackground}" CornerRadius="7" Padding="7,3" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusForeground}" FontSize="10.2" FontWeight="SemiBold"/>
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="文件" Width="330" DisplayMemberBinding="{Binding Entry.RelativePath}"/>
                                    <GridViewColumn Header="说明" Width="250" DisplayMemberBinding="{Binding Message}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="尚无验证结果" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="可生成工作区清单、验证已有清单，或比较两个文件。" FontSize="11.2" Foreground="#7B899C" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SurfaceCard}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="DetailTitle" Text="等待操作" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DetailSubtitle" Text="清单和比较结果将在这里显示。" FontSize="10.8" Foreground="#738298" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ProgressBar x:Name="OperationProgress" Height="5" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="ProgressText" FontSize="10.5" Foreground="#65768D" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Grid.Row="4" x:Name="SelectedPathText" FontSize="10.8" Foreground="#68798F" TextWrapping="Wrap"/>
                    <Border Grid.Row="6" Background="#F7F9FC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="9" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="DetailText" Text="无结果" FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" FontSize="11.2" Foreground="#43556D" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                    <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="OpenPathButton" Content="打开所在位置" Style="{StaticResource SecondaryButton}" IsEnabled="False" Click="OpenPath_Click"/>
                        <Button x:Name="CopyButton" Content="复制详情" Style="{StaticResource SecondaryButton}" IsEnabled="False" Margin="7,0,0,0" Click="Copy_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
