<UserControl x:Class="PersonalWorkbench.ToolsCenterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="工具箱" Style="{StaticResource PageHeading}"/>
                <TextBlock Text="按需打开本地工具；当前只包含经过验证的文件完整性工具。" Style="{StaticResource PageDescription}"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#EAF2FF" CornerRadius="9" Padding="10,6" VerticalAlignment="Center">
                <TextBlock x:Name="WorkspaceBadgeText" Text="未配置工作区" Foreground="#326FD6" FontSize="10.8" FontWeight="SemiBold"
                           MaxWidth="360" TextTrimming="CharacterEllipsis"/>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228"/><ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1.55*"/><ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource SurfaceCard}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="9"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="工具目录" FontSize="13" FontWeight="SemiBold"/>
                    <Border x:Name="IntegrityToolItem" Grid.Row="2" Background="#EAF2FF" BorderBrush="#D5E4FF"
                            BorderThickness="1" CornerRadius="9" Padding="10">
                        <StackPanel>
                            <TextBlock Text="文件完整性" Foreground="#285FAF" FontWeight="SemiBold"/>
                            <TextBlock Text="SHA-256 清单与文件比较" Foreground="#687A92" FontSize="10.4" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Row="4" Text="操作" FontSize="12" FontWeight="SemiBold"/>
                    <StackPanel Grid.Row="6">
                        <Button x:Name="GenerateButton" Content="生成工作区清单" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Stretch" Click="Generate_Click"/>
                        <Button x:Name="VerifyButton" Content="验证清单" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Stretch" Margin="0,7,0,0" Click="Verify_Click"/>
                        <Button x:Name="CompareButton" Content="比较两个文件" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Stretch" Margin="0,7,0,0" Click="Compare_Click"/>
                        <Button x:Name="CancelButton" Content="取消当前操作" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Stretch" Margin="0,7,0,0" IsEnabled="False" Click="Cancel_Click"/>
                    </StackPanel>
                    <TextBlock Grid.Row="8" Text="只读取源文件，不执行文件内容；生成清单时使用相对路径。"
                               Foreground="#8592A4" FontSize="9.8" TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SurfaceCard}" Padding="8">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="ResultTitle" Text="验证结果" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="ResultCountText" FontSize="10.8" Foreground="#708097" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Row="2">
                        <ListView x:Name="VerificationList" BorderThickness="0" Background="Transparent" SelectionChanged="VerificationList_SelectionChanged">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="状态" Width="90">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding StatusBackground}" CornerRadius="7" Padding="7,3" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusForeground}" FontSize="10.2" FontWeight="SemiBold"/>
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="文件" Width="350" DisplayMemberBinding="{Binding Entry.RelativePath}"/>
                                    <GridViewColumn Header="说明" Width="280" DisplayMemberBinding="{Binding Message}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="尚无工具结果" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="从左侧生成或验证清单，也可以比较两个文件。" FontSize="11.2" Foreground="#7B899C" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource SurfaceCard}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="DetailTitle" Text="等待操作" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DetailSubtitle" Text="清单和比较结果将在这里显示。" FontSize="10.8" Foreground="#738298" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ProgressBar x:Name="OperationProgress" Height="5" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="ProgressText" FontSize="10.5" Foreground="#65768D" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Grid.Row="4" x:Name="SelectedPathText" FontSize="10.8" Foreground="#68798F" TextWrapping="Wrap"/>
                    <Border Grid.Row="6" Background="#F7F9FC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="9" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="DetailText" Text="无结果" FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                       FontSize="11.2" Foreground="#43556D" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                    <WrapPanel Grid.Row="8" HorizontalAlignment="Right">
                        <Button x:Name="OpenPathButton" Content="打开位置" Style="{StaticResource SecondaryButton}" IsEnabled="False" Click="OpenPath_Click"/>
                        <Button x:Name="CopyButton" Content="复制详情" Style="{StaticResource SecondaryButton}" IsEnabled="False" Margin="7,0,0,0" Click="Copy_Click"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
