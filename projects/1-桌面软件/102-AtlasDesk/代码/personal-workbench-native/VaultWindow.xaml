<Window x:Class="PersonalWorkbench.VaultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AtlasDesk 加密数据" Width="920" Height="610" MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="#F4F7FB" FontFamily="{StaticResource AppFont}">
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="加密数据" FontSize="21" FontWeight="SemiBold"/>
                <TextBlock Text="这里的数据使用主密码派生密钥加密保存在 vault.bin；Runtime 中不包含任何内容。" FontSize="11.8" Foreground="#6E7D91" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="新增项目" Style="{StaticResource PrimaryButton}" Click="New_Click"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource SurfaceCard}" Padding="8">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="项目" Style="{StaticResource SectionHeading}" Margin="6,4"/>
                    <ListBox x:Name="EntriesList" Grid.Row="2" BorderThickness="0" Background="Transparent" SelectionChanged="EntriesList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="12.8" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding UserName}" FontSize="11" Foreground="#7A899C" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SurfaceCard}" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="10"/>
                        <RowDefinition Height="*"/><RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="名称" Style="{StaticResource SectionHeading}" VerticalAlignment="Center"/>
                    <TextBox x:Name="NameBox" Grid.Column="1" Height="34"/>
                    <TextBlock Grid.Row="2" Text="账号 / 标识" Style="{StaticResource SectionHeading}" VerticalAlignment="Center"/>
                    <TextBox x:Name="UserNameBox" Grid.Row="2" Grid.Column="1" Height="34"/>
                    <TextBlock Grid.Row="4" Text="密钥 / 密码" Style="{StaticResource SectionHeading}" VerticalAlignment="Center"/>
                    <Grid Grid.Row="4" Grid.Column="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="SecretBox" Height="34"/>
                        <Button Grid.Column="2" Content="复制" Style="{StaticResource SecondaryButton}" Height="34" Click="CopySecret_Click"/>
                    </Grid>
                    <TextBlock Grid.Row="6" Text="备注" Style="{StaticResource SectionHeading}" VerticalAlignment="Top"/>
                    <TextBox x:Name="NotesBox" Grid.Row="6" Grid.Column="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                    <WrapPanel Grid.Row="8" Grid.Column="1">
                        <Button Content="保存项目" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                        <Button Content="删除" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Delete_Click"/>
                        <TextBlock x:Name="StatusText" FontSize="11.5" Foreground="#2E7A5D" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="关闭本窗口不会自动锁定保险库；退出 AtlasDesk 时会自动锁定。" FontSize="11.2" Foreground="#7D8A9B" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="关闭" Style="{StaticResource SecondaryButton}" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
