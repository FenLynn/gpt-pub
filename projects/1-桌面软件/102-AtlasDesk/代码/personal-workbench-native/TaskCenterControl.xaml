<UserControl x:Class="PersonalWorkbench.TaskCenterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="任务中心" Style="{StaticResource PageHeading}"/>
                <TextBlock Text="启动、跟踪和回看只读后台任务；不执行工作区脚本。" Style="{StaticResource PageDescription}"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#EAF2FF" CornerRadius="9" Padding="10,6" VerticalAlignment="Center">
                <TextBlock x:Name="RunningBadgeText" Text="0 个运行中" Foreground="#326FD6" FontSize="10.8" FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="218"/><ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1.55*"/><ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource SurfaceCard}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="启动任务" FontSize="13" FontWeight="SemiBold"/>
                    <StackPanel Grid.Row="2">
                        <Button Content="计算文件 SHA-256" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Click="HashFile_Click"/>
                        <Button Content="统计默认工作区" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Margin="0,7,0,0" Click="ScanWorkspace_Click"/>
                    </StackPanel>
                    <Border Grid.Row="4" Height="1" Background="#E7ECF3"/>
                    <TextBlock Grid.Row="6" Text="查找历史" FontSize="12" FontWeight="SemiBold"/>
                    <StackPanel Grid.Row="8">
                        <TextBox x:Name="TaskSearchBox" Height="31" TextChanged="TaskFilter_Changed" ToolTip="按任务名称或路径搜索"/>
                        <ComboBox x:Name="TaskFilter" Height="31" Margin="0,7,0,0" SelectionChanged="TaskFilter_Changed">
                            <ComboBoxItem Content="全部状态" Tag="all" IsSelected="True"/>
                            <ComboBoxItem Content="正在进行" Tag="active"/>
                            <ComboBoxItem Content="已完成" Tag="completed"/>
                            <ComboBoxItem Content="失败 / 取消" Tag="problem"/>
                        </ComboBox>
                        <Button Content="清理已完成" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,9,0,0" Click="ClearFinished_Click"/>
                    </StackPanel>
                    <TextBlock Grid.Row="10" x:Name="HistoryPathText" FontSize="9.8" Foreground="#8A97A9"
                               TextWrapping="Wrap" ToolTip="任务历史文件位置"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SurfaceCard}" Padding="8">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="任务记录" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" x:Name="VisibleCountText" Foreground="#708097" FontSize="10.5" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Row="2">
                        <ListView x:Name="TaskList" BorderThickness="0" Background="Transparent" SelectionChanged="TaskList_SelectionChanged">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="类型" Width="82" DisplayMemberBinding="{Binding TypeLabel}"/>
                                    <GridViewColumn Header="任务" Width="275" DisplayMemberBinding="{Binding Title}"/>
                                    <GridViewColumn Header="状态" Width="84">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding StatusBackground}" CornerRadius="7" Padding="7,3" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding StateLabel}" Foreground="{Binding StatusForeground}" FontSize="10.3" FontWeight="SemiBold"/>
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="进度" Width="72" DisplayMemberBinding="{Binding ProgressLabel}"/>
                                    <GridViewColumn Header="开始时间" Width="116" DisplayMemberBinding="{Binding CreatedLabel}"/>
                                    <GridViewColumn Header="耗时" Width="76" DisplayMemberBinding="{Binding DurationLabel}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="没有符合条件的任务" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="从左侧启动任务，或调整搜索与状态筛选。" FontSize="11.2" Foreground="#7B899C" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource SurfaceCard}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="DetailTitle" Text="选择一个任务" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DetailType" FontSize="10.8" Foreground="#738298" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" x:Name="DetailPath" Text="任务路径和结果将在这里显示。" FontSize="11" Foreground="#68798F" TextWrapping="Wrap"/>
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ProgressBar x:Name="DetailProgress" Height="5" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="DetailProgressText" FontSize="10.5" Foreground="#65768D" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Grid.Row="6" Background="#F7F9FC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="9" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="DetailResult" Text="无结果" FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" FontSize="11.5" Foreground="#43556D" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                    <WrapPanel Grid.Row="8" HorizontalAlignment="Right">
                        <Button x:Name="OpenFolderButton" Content="打开位置" Style="{StaticResource SecondaryButton}" IsEnabled="False" Click="OpenFolder_Click"/>
                        <Button x:Name="CopyResultButton" Content="复制结果" Style="{StaticResource SecondaryButton}" IsEnabled="False" Margin="7,0,0,0" Click="CopyResult_Click"/>
                        <Button x:Name="CancelButton" Content="取消任务" Style="{StaticResource SecondaryButton}" IsEnabled="False" Margin="7,0,0,0" Click="Cancel_Click"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
