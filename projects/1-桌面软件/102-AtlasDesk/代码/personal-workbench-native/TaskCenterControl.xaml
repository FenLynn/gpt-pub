<UserControl x:Class="PersonalWorkbench.TaskCenterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="任务中心" Style="{StaticResource PageHeading}"/>
                <TextBlock Text="运行可取消的只读后台任务，保存结果与失败历史，不执行工作区脚本。" Style="{StaticResource PageDescription}"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#EAF2FF" CornerRadius="9" Padding="10,6" VerticalAlignment="Center">
                <TextBlock x:Name="RunningBadgeText" Text="0 个运行中" Foreground="#326FD6" FontSize="10.8" FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource ToolbarCard}" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Content="计算文件 SHA-256" Style="{StaticResource PrimaryButton}" Click="HashFile_Click"/>
                <Button Grid.Column="2" Content="统计默认工作区" Style="{StaticResource SecondaryButton}" Click="ScanWorkspace_Click"/>
                <Button Grid.Column="4" Content="清理已完成" Style="{StaticResource SecondaryButton}" Click="ClearFinished_Click"/>
                <TextBlock Grid.Column="6" x:Name="HistoryPathText" FontSize="10.5" Foreground="#7B899C" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="340"/>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource SurfaceCard}" Padding="8">
                <Grid>
                    <ListView x:Name="TaskList" ItemsSource="{Binding Tasks}" BorderThickness="0" Background="Transparent"
                              SelectionChanged="TaskList_SelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="类型" Width="80" DisplayMemberBinding="{Binding TypeLabel}"/>
                                <GridViewColumn Header="任务" Width="255" DisplayMemberBinding="{Binding Title}"/>
                                <GridViewColumn Header="状态" Width="80">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding StatusBackground}" CornerRadius="7" Padding="7,3" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding StateLabel}" Foreground="{Binding StatusForeground}" FontSize="10.3" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="进度" Width="70" DisplayMemberBinding="{Binding ProgressLabel}"/>
                                <GridViewColumn Header="开始时间" Width="115" DisplayMemberBinding="{Binding CreatedLabel}"/>
                                <GridViewColumn Header="耗时" Width="75" DisplayMemberBinding="{Binding DurationLabel}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="尚无后台任务" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="选择文件计算 SHA-256，或统计默认工作区。" FontSize="11.2" Foreground="#7B899C" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SurfaceCard}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="DetailTitle" Text="选择一个任务" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DetailType" FontSize="10.8" Foreground="#738298" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" x:Name="DetailPath" Text="任务路径和结果将在这里显示。" FontSize="11" Foreground="#68798F" TextWrapping="Wrap"/>
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ProgressBar x:Name="DetailProgress" Height="5" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="DetailProgressText" Text="" FontSize="10.5" Foreground="#65768D" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Grid.Row="6" Background="#F7F9FC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="9" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="DetailResult" Text="无结果" FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" FontSize="11.5" Foreground="#43556D" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                    <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="OpenFolderButton" Content="打开所在位置" Style="{StaticResource SecondaryButton}" IsEnabled="False" Click="OpenFolder_Click"/>
                        <Button x:Name="CopyResultButton" Content="复制结果" Style="{StaticResource SecondaryButton}" IsEnabled="False" Margin="7,0,0,0" Click="CopyResult_Click"/>
                        <Button x:Name="CancelButton" Content="取消任务" Style="{StaticResource SecondaryButton}" IsEnabled="False" Margin="7,0,0,0" Click="Cancel_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
