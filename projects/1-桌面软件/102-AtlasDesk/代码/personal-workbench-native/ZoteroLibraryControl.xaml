<UserControl x:Class="PersonalWorkbench.ZoteroLibraryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PersonalWorkbench"
             FontFamily="{StaticResource AppFont}">
    <UserControl.Resources>
        <HierarchicalDataTemplate DataType="{x:Type local:ZoteroCollectionNode}" ItemsSource="{Binding Children}">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                    <Path Data="M3,6 H9 L11,8 H21 V19 H3 Z" Stroke="#60758F" StrokeThickness="1.7" Fill="Transparent" StrokeLineJoin="Round"/>
                </Viewbox>
                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="12.5" Foreground="#43536A" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </Grid>
        </HierarchicalDataTemplate>
        <DataTemplate x:Key="FieldRowTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="98"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" FontSize="11.5" Foreground="#8290A3" VerticalAlignment="Top"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12.5" Foreground="#3F5067" TextWrapping="Wrap"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="AttachmentTemplate">
            <Border BorderBrush="#E5EAF1" BorderThickness="0,0,0,1" Padding="0,8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding DisplayTitle}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Status}" FontSize="10.8" Foreground="#7B899C" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding ResolvedPath}" FontSize="10.5" Foreground="#9AA5B4" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="打开" Style="{StaticResource SecondaryButton}" MinWidth="62" Height="30" Margin="8,0,0,0"
                            Tag="{Binding}" IsEnabled="{Binding Exists}" Click="OpenAttachment_Click"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="42"/><RowDefinition Height="10"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Zotero 文献库" FontSize="20" FontWeight="SemiBold"/>
                    <Border x:Name="ConnectionBadge" Background="#EAF8F2" CornerRadius="8" Padding="8,4" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ConnectionText" Text="等待连接" FontSize="10.8" Foreground="#2F7E60"/>
                    </Border>
                    <Border x:Name="LoadModeBadge" Background="#EEF3FA" CornerRadius="8" Padding="8,4" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="LoadModeText" Text="校准模式 · 250" FontSize="10.8" Foreground="#60758F"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="分类层级、元信息、笔记、标签和附件均直接从本机数据库只读获取。" FontSize="12.3" Foreground="#6B7A90" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="刷新文献库" Style="{StaticResource SecondaryButton}" Click="Refresh_Click"/>
                <Button Content="打开设置" Style="{StaticResource SecondaryButton}" Margin="7,0,0,0" Click="OpenSettings_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#E1E8F1" BorderThickness="1" CornerRadius="11" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="150"/><ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="145"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Height="30" Padding="9,5" FontSize="12.5" BorderBrush="#D8E1EC" Background="#FBFCFE"
                         ToolTip="标题、作者、期刊、DOI、摘要与标签" KeyDown="SearchBox_KeyDown"/>
                <ComboBox x:Name="ItemTypeFilter" Grid.Column="2" Height="30" FontSize="12" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="全部类型" Tag="" IsSelected="True"/><ComboBoxItem Content="期刊论文" Tag="journalArticle"/>
                    <ComboBoxItem Content="会议论文" Tag="conferencePaper"/><ComboBoxItem Content="学位论文" Tag="thesis"/>
                    <ComboBoxItem Content="图书 / 章节" Tag="book,bookSection"/><ComboBoxItem Content="专利" Tag="patent"/>
                    <ComboBoxItem Content="报告 / 预印本" Tag="report,preprint"/>
                </ComboBox>
                <ComboBox x:Name="SortFilter" Grid.Column="4" Height="30" FontSize="12" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="最近修改" Tag="modified" IsSelected="True"/><ComboBoxItem Content="最近添加" Tag="added"/>
                    <ComboBoxItem Content="年份倒序" Tag="year"/><ComboBoxItem Content="标题排序" Tag="title"/>
                </ComboBox>
                <CheckBox x:Name="PdfOnlyFilter" Grid.Column="6" Content="仅有 PDF" FontSize="12" VerticalAlignment="Center" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                <Button Grid.Column="8" Content="搜索" Style="{StaticResource PrimaryButton}" Height="30" MinWidth="76" Click="Search_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/><ColumnDefinition Width="9"/><ColumnDefinition Width="390"/></Grid.ColumnDefinitions>

            <Border Background="White" BorderBrush="#E1E8F1" BorderThickness="1" CornerRadius="12" Padding="8">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="7"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="分类" FontSize="12" FontWeight="SemiBold" Foreground="#52647B" Margin="4,2"/>
                    <TreeView x:Name="CollectionTree" Grid.Row="2" BorderThickness="0" Background="Transparent"
                              SelectedItemChanged="CollectionTree_SelectedItemChanged" VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#E1E8F1" BorderThickness="1" CornerRadius="12" Padding="7">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="6"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="4,1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="ResultStatus" Text="等待读取文献库" FontSize="11.3" Foreground="#748296"/>
                        <TextBlock x:Name="CurrentScopeText" Grid.Column="1" FontSize="11.3" Foreground="#8B97A7"/>
                    </Grid>
                    <ListView x:Name="ItemsList" Grid.Row="2" BorderThickness="0" Background="Transparent"
                              SelectionChanged="ItemsList_SelectionChanged" MouseDoubleClick="ItemsList_MouseDoubleClick"
                              VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.IsDeferredScrollingEnabled="True">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="类型" Width="82" DisplayMemberBinding="{Binding ItemTypeLabel}"/>
                                <GridViewColumn Header="标题" Width="390" DisplayMemberBinding="{Binding DisplayTitle}"/>
                                <GridViewColumn Header="作者" Width="170" DisplayMemberBinding="{Binding Authors}"/>
                                <GridViewColumn Header="年份" Width="58" DisplayMemberBinding="{Binding Year}"/>
                                <GridViewColumn Header="期刊 / 来源" Width="190" DisplayMemberBinding="{Binding Publication}"/>
                                <GridViewColumn Header="附件" Width="48" DisplayMemberBinding="{Binding PdfMark}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="4" Background="White" BorderBrush="#E1E8F1" BorderThickness="1" CornerRadius="12" Padding="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="DetailTitle" Text="选择一篇文献" FontSize="16.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DetailAuthors" FontSize="12" Foreground="#607189" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DetailMeta" FontSize="11.5" Foreground="#7A8798" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <WrapPanel Grid.Row="1" Margin="0,10,0,0">
                        <Button x:Name="OpenPrimaryPdfButton" Content="打开 PDF" Style="{StaticResource PrimaryButton}" Height="31" IsEnabled="False" Click="OpenPrimaryPdf_Click"/>
                        <Button x:Name="CopyDoiButton" Content="复制 DOI" Style="{StaticResource SecondaryButton}" Height="31" IsEnabled="False" Margin="7,0,0,0" Click="CopyDoi_Click"/>
                        <Button x:Name="CopyTitleButton" Content="复制标题" Style="{StaticResource SecondaryButton}" Height="31" IsEnabled="False" Margin="7,0,0,0" Click="CopyTitle_Click"/>
                    </WrapPanel>
                    <TabControl Grid.Row="3" x:Name="DetailTabs" Background="Transparent" BorderBrush="#E2E8F0" FontSize="12">
                        <TabItem Header="信息">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2,8,2,2">
                                <StackPanel>
                                    <TextBlock Text="作者与角色" FontSize="11.5" FontWeight="SemiBold" Foreground="#586A81" Margin="0,0,0,5"/>
                                    <ItemsControl x:Name="CreatorsList"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" FontSize="12" Foreground="#465971" Margin="0,2" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                    <Border Height="1" Background="#E8EDF3" Margin="0,10"/>
                                    <ItemsControl x:Name="InfoFields" ItemTemplate="{StaticResource FieldRowTemplate}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="摘要">
                            <TextBox x:Name="AbstractText" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontSize="12.3"
                                     Foreground="#4E6076" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="4,8"/>
                        </TabItem>
                        <TabItem Header="笔记">
                            <ListBox x:Name="NotesList" BorderThickness="0" Background="Transparent" Padding="2,7">
                                <ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#E6EBF2" BorderThickness="0,0,0,1" Padding="0,7"><StackPanel><TextBlock Text="{Binding Text}" FontSize="12.2" Foreground="#4F6076" TextWrapping="Wrap"/><TextBlock Text="{Binding DateModified}" FontSize="10.5" Foreground="#929DAC" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>
                        <TabItem Header="附件">
                            <ListBox x:Name="AttachmentsList" BorderThickness="0" Background="Transparent" Padding="2,3" ItemTemplate="{StaticResource AttachmentTemplate}"/>
                        </TabItem>
                        <TabItem Header="标签 / 分类">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="3,8">
                                <StackPanel>
                                    <TextBlock Text="标签" FontSize="11.5" FontWeight="SemiBold" Foreground="#586A81"/>
                                    <WrapPanel x:Name="TagsPanel" Margin="0,6,0,0"/>
                                    <Border Height="1" Background="#E8EDF3" Margin="0,12"/>
                                    <TextBlock Text="所属分类" FontSize="11.5" FontWeight="SemiBold" Foreground="#586A81"/>
                                    <ItemsControl x:Name="CollectionsList" Margin="0,5,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="12" Foreground="#465971" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="FirstRunOverlay" Grid.RowSpan="5" Background="#F7F9FCF5" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="460">
                <TextBlock Text="连接 Zotero 本地文献库" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="工作台只读访问 zotero.sqlite，不启动 Zotero，也不会修改数据库。自动检测失败时可手动指定。" FontSize="12.8" Foreground="#6B7A90" TextAlignment="Center" TextWrapping="Wrap" Margin="0,9,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <Button Content="自动检测" Style="{StaticResource PrimaryButton}" Click="AutoDetect_Click"/>
                    <Button Content="手动选择" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="ManualSelect_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
