<UserControl x:Class="PersonalWorkbench.TerminalDrawerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}">
    <Border Background="#0D1320" BorderBrush="#26364D" BorderThickness="1,1,0,0">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Background="#111A29">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
                    <Viewbox Width="15" Height="15"><Path Data="M4,5 H20 V19 H4 Z M7,9 L10,12 L7,15 M12,15 H17" Stroke="#8FB5FF" StrokeThickness="1.8" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                    <TextBlock Text="终端" Foreground="#DCE6F5" FontSize="12.3" FontWeight="SemiBold" Margin="7,0,0,0"/>
                    <TextBlock x:Name="SessionSummary" Text="0 个会话" Foreground="#788AA3" FontSize="10.6" Margin="8,1,0,0"/>
                    <TextBlock Text="· ConPTY" Foreground="#556A84" FontSize="10.4" Margin="5,1,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="收起" Style="{StaticResource TerminalHeaderButton}" Margin="0,0,8,0" VerticalAlignment="Center" Click="Collapse_Click"/>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="246"/></Grid.ColumnDefinitions>
                <TabControl x:Name="TerminalTabs" Background="#0D1320" BorderThickness="0" Foreground="#DCE6F5" SelectionChanged="TerminalTabs_SelectionChanged">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Foreground" Value="#9DAEC3"/><Setter Property="Background" Value="#111A29"/>
                            <Setter Property="BorderBrush" Value="#26364D"/><Setter Property="Padding" Value="13,6"/><Setter Property="FontSize" Value="11.4"/>
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,1,1" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#1A2638"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="#4F7EC5"/><Setter Property="Foreground" Value="#EAF2FF"/></Trigger>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#172235"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate></Setter.Value></Setter>
                        </Style>
                    </TabControl.Resources>
                </TabControl>

                <Border Grid.Column="1" Background="#26364D"/>
                <Border Grid.Column="2" Background="#111A29" Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="会话" Foreground="#D7E2F1" FontSize="12.3" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SelectedTitleText" Text="尚未选择会话" Foreground="#AFC1D8" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="SelectedModeText" Text="" Foreground="#71859F" FontSize="10.5" Margin="0,4,0,0"/>
                            <TextBlock x:Name="SelectedPathText" Text="" Foreground="#71859F" FontSize="10.3" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="SelectedProcessText" Text="" Foreground="#71859F" FontSize="10.3" Margin="0,3,0,0"/>

                            <Border Height="1" Background="#283950" Margin="0,12"/>
                            <TextBlock Text="新建会话" Foreground="#8EA2BC" FontSize="10.8" FontWeight="SemiBold"/>
                            <UniformGrid Columns="2" Margin="0,7,0,0">
                                <Button Content="PowerShell" Style="{StaticResource TerminalHeaderButton}" Margin="0,0,4,5" Click="NewPowerShell_Click"/>
                                <Button Content="CMD" Style="{StaticResource TerminalHeaderButton}" Margin="4,0,0,5" Click="NewCmd_Click"/>
                            </UniformGrid>

                            <TextBlock Text="当前会话" Foreground="#8EA2BC" FontSize="10.8" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            <UniformGrid Columns="2" Margin="0,7,0,0">
                                <Button Content="清屏" Style="{StaticResource TerminalHeaderButton}" Margin="0,0,4,5" Click="Clear_Click"/>
                                <Button Content="弹出" Style="{StaticResource TerminalHeaderButton}" Margin="4,0,0,5" Click="PopOut_Click"/>
                                <Button Content="关闭" Style="{StaticResource TerminalHeaderButton}" Margin="0,0,4,5" Click="CloseTab_Click"/>
                                <Button Content="底部停靠" Style="{StaticResource TerminalHeaderButton}" Margin="4,0,0,5" IsEnabled="False" ToolTip="当前终端已经固定在底部抽屉"/>
                            </UniformGrid>

                            <Border Background="#172235" BorderBrush="#293B54" BorderThickness="1" CornerRadius="8" Padding="9" Margin="0,10,0,0">
                                <TextBlock Text="复制：Ctrl+Shift+C&#x0a;粘贴：Ctrl+Shift+V 或右键&#x0a;无选区时 Ctrl+C 仍发送中断" Foreground="#7E92AC" FontSize="10.4" TextWrapping="Wrap" LineHeight="17"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
