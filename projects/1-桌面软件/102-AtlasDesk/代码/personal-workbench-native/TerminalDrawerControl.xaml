<UserControl x:Class="PersonalWorkbench.TerminalDrawerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}"
             Background="#000000">
    <UserControl.Resources>
        <Style x:Key="TerminalTopButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="58"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="BorderBrush" Value="#4A4A4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="10.7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2A2A2A"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#6A6A6A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#363636"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Background" Value="#0F0F0F"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#2B2B2B"/>
                                <Setter Property="Foreground" Value="#787878"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TerminalSideButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,7,7"/>
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="BorderBrush" Value="#4A4A4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="10.7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2A2A2A"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#6A6A6A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#363636"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Background" Value="#0F0F0F"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#2B2B2B"/>
                                <Setter Property="Foreground" Value="#787878"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BuildFailurePanel still resolves this legacy key. -->
        <Style x:Key="TerminalHeaderButton" TargetType="Button" BasedOn="{StaticResource TerminalTopButton}"/>
    </UserControl.Resources>

    <Border Background="#000000" BorderBrush="#2B2B2B" BorderThickness="1,1,0,0">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="236"/></Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#0A0A0A" BorderBrush="#2B2B2B" BorderThickness="0,0,0,1"/>

            <TabControl x:Name="TerminalTabs" Grid.RowSpan="2" Grid.Column="0"
                        Background="#000000" BorderThickness="0" Foreground="#F0F0F0"
                        SelectionChanged="TerminalTabs_SelectionChanged">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True" Margin="116,0,282,0"
                                      Background="Transparent" VerticalAlignment="Stretch"/>
                            <Border Grid.Row="1" Background="#000000">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Foreground" Value="#BEBEBE"/>
                        <Setter Property="Background" Value="#0A0A0A"/>
                        <Setter Property="BorderBrush" Value="#303030"/>
                        <Setter Property="Padding" Value="13,0"/>
                        <Setter Property="Height" Value="40"/>
                        <Setter Property="MinWidth" Value="54"/>
                        <Setter Property="FontSize" Value="11.2"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="0,0,1,0" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="#202020"/>
                                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="#D0D0D0"/>
                                            <Setter TargetName="TabBorder" Property="BorderThickness" Value="0,0,1,2"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="#181818"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>
            </TabControl>

            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0"
                        HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                <Viewbox Width="15" Height="15">
                    <Path Data="M4,5 H20 V19 H4 Z M7,9 L10,12 L7,15 M12,15 H17"
                          Stroke="#E5E5E5" StrokeThickness="1.75" Fill="Transparent"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Viewbox>
                <TextBlock x:Name="SessionSummary" Text="0 个会话" Foreground="#F2F2F2" FontSize="10.9"
                           FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,8,0">
                <Button Content="CMD" Width="58" Style="{StaticResource TerminalTopButton}" Margin="0,0,5,0" Click="NewCmd_Click"/>
                <Button Content="PowerShell" Width="88" Style="{StaticResource TerminalTopButton}" Margin="0,0,5,0" Click="NewPowerShell_Click"/>
                <Button x:Name="HostActionButton" Content="收起" Width="88" Style="{StaticResource TerminalTopButton}" Click="Collapse_Click"/>
            </StackPanel>

            <Grid x:Name="TerminalEmptyState" Grid.Row="1" Grid.Column="0" Background="#000000" IsHitTestVisible="False">
                <StackPanel Width="360" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="54" Height="54" CornerRadius="14" Background="#171717" BorderBrush="#333333" BorderThickness="1" HorizontalAlignment="Center">
                        <Viewbox Width="25" Height="25">
                            <Path Data="M4,5 H20 V19 H4 Z M7,9 L10,12 L7,15 M12,15 H17"
                                  Stroke="#F0F0F0" StrokeThickness="1.8" Fill="Transparent"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Viewbox>
                    </Border>
                    <TextBlock Text="新建一个终端会话" Foreground="#FFFFFF" FontSize="14.5" FontWeight="SemiBold"
                               TextAlignment="Center" Margin="0,13,0,0"/>
                    <TextBlock Text="标签会保留在顶部，可在开发页、底部固定栏和独立窗口之间移动。"
                               Foreground="#A8A8A8" FontSize="11.3" TextAlignment="Center" TextWrapping="Wrap"
                               LineHeight="18" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Grid.Column="1" Background="#303030"/>

            <Border Grid.Row="1" Grid.Column="2" Background="#0D0D0D" Padding="14,13">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="当前会话" Foreground="#FFFFFF" FontSize="12.2" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SelectedTitleText" Text="尚未选择会话" Foreground="#F0F0F0"
                                   FontSize="12" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SelectedModeText" Foreground="#B8B8B8" FontSize="10.5" Margin="0,4,0,0"/>
                        <TextBlock x:Name="SelectedPathText" Foreground="#A8A8A8" FontSize="10.2" Margin="0,4,0,0"
                                   TextWrapping="Wrap" MaxHeight="50" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        <TextBlock x:Name="SelectedProcessText" Foreground="#A8A8A8" FontSize="10.2" Margin="0,3,0,0"
                                   TextWrapping="Wrap"/>

                        <Border Height="1" Background="#333333" Margin="0,13"/>
                        <TextBlock Text="标签操作" Foreground="#D8D8D8" FontSize="10.7" FontWeight="SemiBold"/>
                        <UniformGrid Columns="2" Margin="0,9,0,0">
                            <Button Content="清屏" Style="{StaticResource TerminalSideButton}" Click="Clear_Click"/>
                            <Button x:Name="RestartButton" Content="重启" Style="{StaticResource TerminalSideButton}" IsEnabled="False" Click="Restart_Click"/>
                            <Button Content="弹出" Style="{StaticResource TerminalSideButton}" Click="PopOut_Click"/>
                            <Button Content="关闭" Style="{StaticResource TerminalSideButton}" Click="CloseTab_Click"/>
                        </UniformGrid>
                        <Button x:Name="HostModeButton" Content="嵌入开发页" Style="{StaticResource TerminalSideButton}"
                                Margin="0,0,0,8" HorizontalAlignment="Stretch" Click="HostMode_Click"/>

                        <Border Background="#151515" BorderBrush="#3B3B3B" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,4,0,0">
                            <TextBlock Text="复制  Ctrl+Shift+C&#x0a;粘贴  Ctrl+Shift+V 或右键&#x0a;&#x0a;弹出窗口支持置顶和全屏，并可随时嵌回。"
                                       Foreground="#BEBEBE" FontSize="10.3" TextWrapping="Wrap" LineHeight="17"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</UserControl>