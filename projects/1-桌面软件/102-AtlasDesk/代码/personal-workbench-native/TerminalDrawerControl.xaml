<UserControl x:Class="PersonalWorkbench.TerminalDrawerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}">
    <Border Background="#0D1320" BorderBrush="#26364D" BorderThickness="1,1,0,0">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Background="#111A29">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="10,0,10,0" VerticalAlignment="Center">
                    <Viewbox Width="16" Height="16"><Path Data="M4,5 H20 V19 H4 Z M7,9 L10,12 L7,15 M12,15 H17" Stroke="#8FB5FF" StrokeThickness="1.8" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                    <TextBlock Text="终端" Foreground="#DCE6F5" FontSize="12.5" FontWeight="SemiBold" Margin="7,0,0,0"/>
                    <TextBlock x:Name="SessionSummary" Text="0 个会话" Foreground="#788AA3" FontSize="10.8" Margin="8,1,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,0,8,0" VerticalAlignment="Center">
                    <Button Content="+ PowerShell" Style="{StaticResource TerminalHeaderButton}" Click="NewPowerShell_Click"/>
                    <Button Content="+ CMD" Style="{StaticResource TerminalHeaderButton}" Margin="5,0,0,0" Click="NewCmd_Click"/>
                    <Button Content="清屏" Style="{StaticResource TerminalHeaderButton}" Margin="5,0,0,0" Click="Clear_Click"/>
                    <Button Content="关闭标签" Style="{StaticResource TerminalHeaderButton}" Margin="5,0,0,0" Click="CloseTab_Click"/>
                    <Button Content="收起" Style="{StaticResource TerminalHeaderButton}" Margin="5,0,0,0" Click="Collapse_Click"/>
                </StackPanel>
            </Grid>
            <TabControl x:Name="TerminalTabs" Grid.Row="1" Background="#0D1320" BorderThickness="0" Foreground="#DCE6F5"
                        SelectionChanged="TerminalTabs_SelectionChanged">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Foreground" Value="#9DAEC3"/><Setter Property="Background" Value="#111A29"/>
                        <Setter Property="BorderBrush" Value="#26364D"/><Setter Property="Padding" Value="12,5"/>
                        <Setter Property="FontSize" Value="11.5"/><Setter Property="Template">
                            <Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,1,1" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#1A2638"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="#4F7EC5"/><Setter Property="Foreground" Value="#EAF2FF"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#172235"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>
            </TabControl>
        </Grid>
    </Border>
</UserControl>
