<UserControl x:Class="PersonalWorkbench.TerminalDrawerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}">
    <UserControl.Resources>
        <Style x:Key="TerminalTopButton" TargetType="Button">
            <Setter Property="Height" Value="27"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Background" Value="#263B58"/>
            <Setter Property="Foreground" Value="#F5F8FE"/>
            <Setter Property="BorderBrush" Value="#55749A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="10.7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#35577F"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#82A9D9"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Background" Value="#416B9D"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Background" Value="#18263A"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#334963"/>
                                <Setter Property="Foreground" Value="#8294AC"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TerminalSideButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,6,7"/>
            <Setter Property="Background" Value="#1D2D43"/>
            <Setter Property="Foreground" Value="#E7EFFA"/>
            <Setter Property="BorderBrush" Value="#405B7B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="10.7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2B4565"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#668BB7"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Background" Value="#172438"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#2D4058"/>
                                <Setter Property="Foreground" Value="#71839A"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BuildFailurePanel still resolves this legacy key. -->
        <Style x:Key="TerminalHeaderButton" TargetType="Button" BasedOn="{StaticResource TerminalTopButton}"/>
    </UserControl.Resources>

    <Border Background="#0D1320" BorderBrush="#27374D" BorderThickness="1,1,0,0">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#111A29" BorderBrush="#293B54" BorderThickness="0,0,0,1"/>

            <TabControl x:Name="TerminalTabs" Grid.RowSpan="2" Grid.Column="0"
                        Background="#0D1320" BorderThickness="0" Foreground="#DCE6F5"
                        SelectionChanged="TerminalTabs_SelectionChanged">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True" Margin="116,0,246,0"
                                      Background="Transparent" VerticalAlignment="Stretch"/>
                            <Border Grid.Row="1" Background="#0D1320">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Foreground" Value="#B8C8DC"/>
                        <Setter Property="Background" Value="#111A29"/>
                        <Setter Property="BorderBrush" Value="#2B3C54"/>
                        <Setter Property="Padding" Value="13,0"/>
                        <Setter Property="Height" Value="38"/>
                        <Setter Property="MinWidth" Value="54"/>
                        <Setter Property="FontSize" Value="11.2"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="0,0,1,0" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="#1D2D43"/>
                                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="#598ED3"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="#19283C"/>
                                            <Setter Property="Foreground" Value="#F0F5FC"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>
            </TabControl>

            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0"
                        HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                <Viewbox Width="15" Height="15">
                    <Path Data="M4,5 H20 V19 H4 Z M7,9 L10,12 L7,15 M12,15 H17"
                          Stroke="#A9C9FF" StrokeThickness="1.75" Fill="Transparent"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Viewbox>
                <TextBlock x:Name="SessionSummary" Text="0 个会话" Foreground="#E8F0FC" FontSize="10.9"
                           FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,8,0">
                <Button Content="CMD" Style="{StaticResource TerminalTopButton}" Margin="0,0,5,0" Click="NewCmd_Click"/>
                <Button Content="PowerShell" Style="{StaticResource TerminalTopButton}" Margin="0,0,5,0" Click="NewPowerShell_Click"/>
                <Button x:Name="HostActionButton" Content="收起" Style="{StaticResource TerminalTopButton}" Click="Collapse_Click"/>
            </StackPanel>

            <Grid x:Name="TerminalEmptyState" Grid.Row="1" Grid.Column="0" Background="#0D1320" IsHitTestVisible="False">
                <StackPanel Width="340" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="54" Height="54" CornerRadius="16" Background="#17243A" HorizontalAlignment="Center">
                        <Viewbox Width="25" Height="25">
                            <Path Data="M4,5 H20 V19 H4 Z M7,9 L10,12 L7,15 M12,15 H17"
                                  Stroke="#8DB4FF" StrokeThickness="1.8" Fill="Transparent"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Viewbox>
                    </Border>
                    <TextBlock Text="新建一个终端会话" Foreground="#EAF1FB" FontSize="14.5" FontWeight="SemiBold"
                               TextAlignment="Center" Margin="0,13,0,0"/>
                    <TextBlock Text="标签会保留在顶部，可在开发页、底部固定栏和独立窗口之间移动。"
                               Foreground="#94A6BD" FontSize="11.3" TextAlignment="Center" TextWrapping="Wrap"
                               LineHeight="18" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Grid.Column="1" Background="#2A3B53"/>

            <Border Grid.Row="1" Grid.Column="2" Background="#111A29" Padding="13,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="当前会话" Foreground="#F2F6FC" FontSize="12.2" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SelectedTitleText" Text="尚未选择会话" Foreground="#E0E8F4"
                                   FontSize="12" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SelectedModeText" Foreground="#AABAD0" FontSize="10.5" Margin="0,4,0,0"/>
                        <TextBlock x:Name="SelectedPathText" Foreground="#9DAFC5" FontSize="10.2" Margin="0,4,0,0"
                                   TextWrapping="Wrap" MaxHeight="50" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        <TextBlock x:Name="SelectedProcessText" Foreground="#9DAFC5" FontSize="10.2" Margin="0,3,0,0"
                                   TextWrapping="Wrap"/>

                        <Border Height="1" Background="#30445E" Margin="0,12"/>
                        <TextBlock Text="标签操作" Foreground="#BFD0E4" FontSize="10.7" FontWeight="SemiBold"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="清屏" Style="{StaticResource TerminalSideButton}" Click="Clear_Click"/>
                            <Button x:Name="RestartButton" Content="重启" Style="{StaticResource TerminalSideButton}" IsEnabled="False" Click="Restart_Click"/>
                            <Button Content="弹出" Style="{StaticResource TerminalSideButton}" Click="PopOut_Click"/>
                            <Button Content="关闭" Style="{StaticResource TerminalSideButton}" Click="CloseTab_Click"/>
                            <Button x:Name="HostModeButton" Content="嵌入开发页" Style="{StaticResource TerminalSideButton}" Click="HostMode_Click"/>
                        </WrapPanel>

                        <Border Background="#18263A" BorderBrush="#344A67" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,9,0,0">
                            <TextBlock Text="复制  Ctrl+Shift+C&#x0a;粘贴  Ctrl+Shift+V 或右键&#x0a;&#x0a;弹出窗口支持置顶和全屏，并可随时嵌回。"
                                       Foreground="#A8BAD0" FontSize="10.3" TextWrapping="Wrap" LineHeight="17"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</UserControl>
