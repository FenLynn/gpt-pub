<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="Version.props" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>AtlasDesk</AssemblyName>
    <RootNamespace>PersonalWorkbench</RootNamespace>
    <Version>$(WorkbenchVersion)</Version>
    <FileVersion>$(WorkbenchVersion).0</FileVersion>
    <AssemblyVersion>$(WorkbenchVersion).0</AssemblyVersion>

    <!-- Lightweight distribution: bundle only the app and direct UI dependencies. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="WpfMath" Version="2.1.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="TerminalAssets\**\*">
      <Link>Assets\Terminal\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="NormalizeSources" BeforeTargets="PrepareForBuild">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$p='$(MSBuildProjectDirectory)\MainWindow.xaml'; $c=[IO.File]::ReadAllText($p); $c=$c.Replace(' TextTrimming=\&quot;CharacterEllipsis\&quot;',''); $messages=@('v0.5.0：Zotero 三栏资料库与内置多标签终端已接入，仍坚持只读、轻量和手动可控。','v0.6.0：统一视觉系统与本地工作区已接入，支持轻量 Markdown 编辑、预览和外部文件协作。','v0.6.1：本地工作区、Markdown、真实首页与全局搜索已接入。','v0.6.2：启动保护、诊断中心与自动烟雾测试已接入。','v0.6.3：项目中心已接入，可识别并快速进入多种本地工程。','v0.6.4：真实任务中心已接入，支持可取消的哈希与目录统计任务。','v0.6.5：文件完整性中心已接入，支持生成、验证清单和文件比较。'); foreach($m in $messages){$c=$c.Replace($m,'v0.6.6：配置备份与迁移已接入，五阶段功能完成全量回归。')}; [IO.File]::WriteAllText($p,$c,[Text.UTF8Encoding]::new($false)); $z='$(MSBuildProjectDirectory)\ZoteroLibrary.cs'; $s=[IO.File]::ReadAllText($z); $s=$s.Replace('AND i.itemType=@itemType','AND instr('','' || @itemType || '','', '','' || i.itemType || '','') &gt; 0').Replace('public static string GetItemTypeLabel(string itemType) =&gt; ItemTypeLabels.TryGetValue(itemType ?? string.Empty, out var label) ? label : itemType;','public static string GetItemTypeLabel(string? itemType) =&gt; !string.IsNullOrWhiteSpace(itemType) &amp;&amp; ItemTypeLabels.TryGetValue(itemType, out var label) ? label : itemType ?? string.Empty;'); [IO.File]::WriteAllText($z,$s,[Text.UTF8Encoding]::new($false)); $w='$(MSBuildProjectDirectory)\WorkspaceControl.xaml.cs'; $wc=[IO.File]::ReadAllText($w); $wc=$wc.Replace('await Task.Run(() =&gt; node.LoadChildren(_settings.WorkspaceShowHiddenFiles));','node.LoadChildren(_settings.WorkspaceShowHiddenFiles);').Replace('try { await EnsureLoadedAsync(); }','try { await Dispatcher.InvokeAsync(EnsureLoadedAsync).Task.Unwrap(); }').Replace('ShowWorkspaceFailure(_settings.WorkspaceRoot, ex.Message, recovered: true);','await Dispatcher.InvokeAsync(() =&gt; ShowWorkspaceFailure(_settings.WorkspaceRoot, ex.Message, recovered: true));'); if($wc -notmatch 'ShowWorkspaceFailureCore'){ $wc=$wc.Replace('private void ShowWorkspaceFailure(string root, string message, bool recovered)','private void ShowWorkspaceFailure(string root, string message, bool recovered) { if (!Dispatcher.CheckAccess()) { Dispatcher.BeginInvoke(new Action(() =&gt; ShowWorkspaceFailure(root, message, recovered))); return; } ShowWorkspaceFailureCore(root, message, recovered); } private void ShowWorkspaceFailureCore(string root, string message, bool recovered)') }; [IO.File]::WriteAllText($w,$wc,[Text.UTF8Encoding]::new($false)); $e='$(MSBuildProjectDirectory)\WorkbenchEnhancer.cs'; $ec=[IO.File]::ReadAllText($e); if($ec -notmatch 'ShowWorkspaceCoreAsync'){ $ec=$ec.Replace('private async Task ShowWorkspaceAsync()','private async Task ShowWorkspaceAsync() { if (!_window.Dispatcher.CheckAccess()) { await _window.Dispatcher.InvokeAsync(ShowWorkspaceAsync).Task.Unwrap(); return; } await ShowWorkspaceCoreAsync(); } private async Task ShowWorkspaceCoreAsync()') }; if($ec -notmatch 'ShowZoteroCoreAsync'){ $ec=$ec.Replace('private async Task ShowZoteroAsync()','private async Task ShowZoteroAsync() { if (!_window.Dispatcher.CheckAccess()) { await _window.Dispatcher.InvokeAsync(ShowZoteroAsync).Task.Unwrap(); return; } await ShowZoteroCoreAsync(); } private async Task ShowZoteroCoreAsync()') }; [IO.File]::WriteAllText($e,$ec,[Text.UTF8Encoding]::new($false)); $a='$(MSBuildProjectDirectory)\AccessibilityCoordinator.cs'; $ac=[IO.File]::ReadAllText($a); $ac=$ac.Replace('if (element.ActualWidth &lt;= 0 || element.ActualHeight &lt;= 0) return false;','if (element.ActualWidth &lt;= 0 || element.ActualHeight &lt;= 0 || element.DesiredSize.Width &lt;= 0 || element.DesiredSize.Height &lt;= 0) return false;'); [IO.File]::WriteAllText($a,$ac,[Text.UTF8Encoding]::new($false)); $x='$(MSBuildProjectDirectory)\WorkspaceControl.xaml'; $xc=[IO.File]::ReadAllText($x); $xc=$xc.Replace('x:Name=\&quot;EditorBox\&quot; AcceptsReturn=\&quot;True\&quot;','x:Name=\&quot;EditorBox\&quot; VerticalContentAlignment=\&quot;Top\&quot; AcceptsReturn=\&quot;True\&quot;'); [IO.File]::WriteAllText($x,$xc,[Text.UTF8Encoding]::new($false)); $v='$(MSBuildProjectDirectory)\V0612ExperienceEnhancer.cs'; if(Test-Path $v){$vc=[IO.File]::ReadAllText($v); $vc=$vc.Replace('var path = new Path','var path = new System.Windows.Shapes.Path').Replace('Child = new Path','Child = new System.Windows.Shapes.Path'); [IO.File]::WriteAllText($v,$vc,[Text.UTF8Encoding]::new($false))}; $md='$(MSBuildProjectDirectory)\MarkdownDocumentRenderer.cs'; if(Test-Path $md){$mdc=[IO.File]::ReadAllText($md); $mdc=$mdc.Replace('var source = LoadImage(imageTarget, documentPath);','var source = MarkdownImageLoader.Load(imageTarget, documentPath);').Replace('var source = LoadImage(target, documentPath);','var source = MarkdownImageLoader.Load(target, documentPath);'); [IO.File]::WriteAllText($md,$mdc,[Text.UTF8Encoding]::new($false))}&quot;" />
  </Target>

  <!-- TerminalDrawerControl predates the transport abstraction. Keep its public
       surface stable while selecting the system ConPTY adapter for CMD and the
       existing transport for PowerShell/Conda. The replacements are idempotent. -->
  <Target Name="SelectTerminalTransport" BeforeTargets="CoreCompile" AfterTargets="NormalizeSources">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$p='$(MSBuildProjectDirectory)\TerminalDrawerControl.xaml.cs'; $c=[IO.File]::ReadAllText($p); $c=$c.Replace('var session = ConPtySession.Start(state.Spec, state.Columns, state.Rows);','var session = TerminalSessionFactory.Start(state.Spec, state.Columns, state.Rows);'); $c=$c.Replace('private async Task HandleSessionExitedAsync(TerminalTabState state, ConPtySession session, int code)','private async Task HandleSessionExitedAsync(TerminalTabState state, ITerminalSession session, int code)'); $c=$c.Replace('public ConPtySession? Session { get; set; }','public ITerminalSession? Session { get; set; }'); [IO.File]::WriteAllText($p,$c,[Text.UTF8Encoding]::new($false))&quot;" />
  </Target>
</Project>
