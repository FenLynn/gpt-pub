<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>PersonalWorkbench.App</AssemblyName>
    <RootNamespace>PersonalWorkbench</RootNamespace>
    <Version>0.3.1</Version>
    <FileVersion>0.3.1.0</FileVersion>
    <AssemblyVersion>0.3.1.0</AssemblyVersion>

    <!-- Lightweight distribution: bundle only the app and its direct dependencies. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3240.44" />
  </ItemGroup>

  <Target Name="NormalizeSources" BeforeTargets="PrepareForBuild">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$p='$(MSBuildProjectDirectory)\MainWindow.xaml'; $c=[IO.File]::ReadAllText($p); $c=$c.Replace('WindowStartupLocation=\&quot;CenterScreen\&quot; Background=\&quot;#EEF3F9\&quot;','WindowStartupLocation=\&quot;CenterScreen\&quot;'); [IO.File]::WriteAllText($p,$c,[Text.UTF8Encoding]::new($false)); $p='$(MSBuildProjectDirectory)\MainWindow.xaml.cs'; $c=[IO.File]::ReadAllText($p); $c=$c.Replace('var text = titles.TryGetValue(view, out var item) ? item : (\&quot;模块\&quot;, \&quot;功能准备中\&quot;);','(string title, string subtitle) text = titles.TryGetValue(view, out var item) ? item : (\&quot;模块\&quot;, \&quot;功能准备中\&quot;);'); [IO.File]::WriteAllText($p,$c,[Text.UTF8Encoding]::new($false))&quot;" />
  </Target>
</Project>
