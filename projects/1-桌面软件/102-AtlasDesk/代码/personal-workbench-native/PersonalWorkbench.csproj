<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>PersonalWorkbench.App</AssemblyName>
    <RootNamespace>PersonalWorkbench</RootNamespace>
    <Version>0.4.0</Version>
    <FileVersion>0.4.0.0</FileVersion>
    <AssemblyVersion>0.4.0.0</AssemblyVersion>

    <!-- Lightweight distribution: bundle only the app and its direct dependencies. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3240.44" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.7" />
    <Using Include="System.IO" />
  </ItemGroup>

  <Target Name="NormalizeSources" BeforeTargets="PrepareForBuild">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$p='$(MSBuildProjectDirectory)\MainWindow.xaml'; $c=[IO.File]::ReadAllText($p); $c=$c.Replace(' TextTrimming=\&quot;CharacterEllipsis\&quot;',''); [IO.File]::WriteAllText($p,$c,[Text.UTF8Encoding]::new($false))&quot;" />
  </Target>
</Project>
