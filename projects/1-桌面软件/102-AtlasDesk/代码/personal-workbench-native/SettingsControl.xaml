<UserControl x:Class="PersonalWorkbench.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20" MaxWidth="1050" HorizontalAlignment="Left">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="设置" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="自动检测只是辅助；路径、加载范围和默认行为均可手动确定。" FontSize="13" Foreground="#6B7A90" Margin="0,4,0,0"/>
            </StackPanel>

            <Border Grid.Row="2" Style="{StaticResource HomeCard}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Grid.ColumnSpan="2" Text="基本与 Dashboard" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <TextBlock Grid.Row="2" Text="用户名" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox x:Name="UserNameBox" Grid.Row="2" Grid.Column="1" Height="34" Padding="9,6" FontSize="12.5" BorderBrush="#D8E1EC" Background="#FBFCFE"/>
                    <TextBlock Grid.Row="4" Text="Dashboard" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/><Grid Grid.Row="4" Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox x:Name="DashboardNameBox" Height="34" Padding="9,6" FontSize="12.5" BorderBrush="#D8E1EC" Background="#FBFCFE"/><TextBox x:Name="DashboardUrlBox" Grid.Column="2" Height="34" Padding="9,6" FontSize="12.5" BorderBrush="#D8E1EC" Background="#FBFCFE"/></Grid>
                    <TextBlock Grid.Row="6" Text="工作区目录" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/><Grid Grid.Row="6" Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="WorkspaceBox" Height="34" Padding="9,6" FontSize="12.5" BorderBrush="#D8E1EC" Background="#FBFCFE"/><Button Grid.Column="2" Content="选择" Style="{StaticResource SecondaryButton}" Height="34" Click="BrowseWorkspace_Click"/></Grid>
                </Grid>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource HomeCard}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Grid.ColumnSpan="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Zotero 与 PDF" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="数据库严格只读；PDF 交由外部阅读器打开。" FontSize="11.3" Foreground="#7A8798" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="自动检测" Style="{StaticResource SecondaryButton}" Height="31" Click="DetectZotero_Click"/><Button Content="手动选择" Style="{StaticResource SecondaryButton}" Height="31" Margin="7,0,0,0" Click="BrowseZotero_Click"/></StackPanel></Grid>
                    <TextBlock Grid.Row="2" Text="Zotero 数据库" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox x:Name="ZoteroBox" Grid.Row="2" Grid.Column="1" Height="34" Padding="9,6" FontSize="12.5" BorderBrush="#D8E1EC" Background="#FBFCFE"/>
                    <TextBlock Grid.Row="4" Text="PDF 阅读器" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/><Grid Grid.Row="4" Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="SystemPdfCheck" Content="使用系统默认程序" VerticalAlignment="Center" FontSize="12" Checked="SystemPdfCheck_Changed" Unchecked="SystemPdfCheck_Changed"/><TextBox x:Name="PdfReaderBox" Grid.Column="2" Height="34" Padding="9,6" FontSize="12.5" BorderBrush="#D8E1EC" Background="#FBFCFE"/><Button Grid.Column="4" Content="选择 EXE" Style="{StaticResource SecondaryButton}" Height="34" Click="BrowsePdfReader_Click"/></Grid>
                    <TextBlock Grid.Row="6" Text="加载范围" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/><Grid Grid.Row="6" Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><RadioButton x:Name="CalibrationModeRadio" Content="校准模式" GroupName="ZoteroLoadMode" VerticalAlignment="Center" Checked="LoadMode_Changed"/><RadioButton x:Name="FullModeRadio" Grid.Column="2" Content="全量文献库" GroupName="ZoteroLoadMode" VerticalAlignment="Center" Checked="LoadMode_Changed"/><TextBox x:Name="CalibrationLimitBox" Grid.Column="4" Height="32" Padding="8,5" FontSize="12" BorderBrush="#D8E1EC" Background="#FBFCFE"/><TextBlock Grid.Column="5" Text="默认 250 条；全量模式仍使用虚拟列表，但首次查询会更慢。" FontSize="11.2" Foreground="#77869A" VerticalAlignment="Center" Margin="8,0,0,0"/></Grid>
                </Grid>
            </Border>

            <Border Grid.Row="6" Style="{StaticResource HomeCard}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Grid.ColumnSpan="2" Text="Python 与内置终端" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="2" Text="Conda" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/><Grid Grid.Row="2" Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="CondaBox" Height="34" Padding="9,6" FontSize="12.5" BorderBrush="#D8E1EC" Background="#FBFCFE"/><Button Grid.Column="2" Content="选择" Style="{StaticResource SecondaryButton}" Height="34" Click="BrowseConda_Click"/></Grid>
                    <TextBlock Grid.Row="4" Text="uv" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/><Grid Grid.Row="4" Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="UvBox" Height="34" Padding="9,6" FontSize="12.5" BorderBrush="#D8E1EC" Background="#FBFCFE"/><Button Grid.Column="2" Content="选择" Style="{StaticResource SecondaryButton}" Height="34" Click="BrowseUv_Click"/></Grid>
                    <TextBlock Grid.Row="6" Text="默认 Shell" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox x:Name="DefaultShellBox" Grid.Row="6" Grid.Column="1" Width="190" Height="34" HorizontalAlignment="Left" FontSize="12.5"><ComboBoxItem Content="PowerShell" Tag="powershell"/><ComboBoxItem Content="CMD" Tag="cmd"/></ComboBox>
                    <TextBlock Grid.Row="8" Text="终端显示" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal"><TextBlock Text="字号" FontSize="12" VerticalAlignment="Center"/><ComboBox x:Name="TerminalFontSizeBox" Width="78" Height="32" Margin="8,0,18,0"><ComboBoxItem Content="12"/><ComboBoxItem Content="13"/><ComboBoxItem Content="14"/><ComboBoxItem Content="15"/><ComboBoxItem Content="16"/><ComboBoxItem Content="18"/></ComboBox><TextBlock Text="抽屉高度" FontSize="12" VerticalAlignment="Center"/><TextBox x:Name="TerminalHeightBox" Width="86" Height="32" Padding="8,5" Margin="8,0,0,0" BorderBrush="#D8E1EC" Background="#FBFCFE"/><TextBlock Text="px" FontSize="11.5" Foreground="#7B899C" VerticalAlignment="Center" Margin="5,0,0,0"/></StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="8" Orientation="Horizontal">
                <Button Content="保存设置" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                <Button Content="清除 Access 会话" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="ClearAccess_Click"/>
                <Button Content="打开配置目录" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="OpenConfig_Click"/>
                <TextBlock x:Name="SaveStatus" FontSize="11.5" Foreground="#33805E" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
