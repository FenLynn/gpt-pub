<UserControl x:Class="PersonalWorkbench.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="18" MaxWidth="1120" HorizontalAlignment="Left">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="20"/></Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="设置" Style="{StaticResource PageHeading}"/>
                <TextBlock Text="自动检测只负责找到候选位置；数据源、默认行为和工具路径始终由你最终确定。" Style="{StaticResource PageDescription}"/>
            </StackPanel>

            <Border Grid.Row="2" Style="{StaticResource SurfaceCard}" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Grid.ColumnSpan="2"><TextBlock Text="基本与本地工作区" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Dashboard、文件工作区与编辑器的常用行为。" FontSize="11.3" Foreground="#7A8798" Margin="0,3,0,0"/></StackPanel>

                    <TextBlock Grid.Row="2" Text="用户名" Style="{StaticResource SectionHeading}" VerticalAlignment="Center"/>
                    <TextBox x:Name="UserNameBox" Grid.Row="2" Grid.Column="1" Height="34"/>

                    <TextBlock Grid.Row="4" Text="Dashboard" Style="{StaticResource SectionHeading}" VerticalAlignment="Center"/>
                    <Grid Grid.Row="4" Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox x:Name="DashboardNameBox" Height="34" ToolTip="工作台顶部显示名称"/><TextBox x:Name="DashboardUrlBox" Grid.Column="2" Height="34" ToolTip="Cloudflare Pages 地址"/></Grid>

                    <TextBlock Grid.Row="6" Text="工作区目录" Style="{StaticResource SectionHeading}" VerticalAlignment="Center"/>
                    <Grid Grid.Row="6" Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="WorkspaceBox" Height="34"/><Button Grid.Column="2" Content="选择目录" Style="{StaticResource SecondaryButton}" Height="34" Click="BrowseWorkspace_Click"/></Grid>

                    <TextBlock Grid.Row="8" Text="编辑器行为" Style="{StaticResource SectionHeading}" VerticalAlignment="Center"/>
                    <WrapPanel Grid.Row="8" Grid.Column="1" VerticalAlignment="Center">
                        <CheckBox x:Name="WorkspaceAutoSaveCheck" Content="停止输入后自动保存" Margin="0,0,18,0"/>
                        <CheckBox x:Name="WorkspaceHiddenCheck" Content="显示隐藏文件" Margin="0,0,22,0"/>
                        <TextBlock Text="字号" FontSize="12" Foreground="#5B6D84" VerticalAlignment="Center"/>
                        <ComboBox x:Name="WorkspaceFontSizeBox" Width="70" Height="31" Margin="7,0,18,0"><ComboBoxItem Content="12"/><ComboBoxItem Content="13"/><ComboBoxItem Content="14"/><ComboBoxItem Content="15"/><ComboBoxItem Content="16"/><ComboBoxItem Content="18"/><ComboBoxItem Content="20"/></ComboBox>
                        <TextBlock Text="最近文件" FontSize="12" Foreground="#5B6D84" VerticalAlignment="Center"/>
                        <TextBox x:Name="WorkspaceRecentLimitBox" Width="72" Height="31" Margin="7,0,5,0"/>
                        <TextBlock Text="项" FontSize="11.5" Foreground="#8A97A8" VerticalAlignment="Center"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource SurfaceCard}" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Grid.ColumnSpan="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Zotero 与 PDF" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="数据库严格只读；PDF 交由系统默认程序或指定阅读器。" FontSize="11.3" Foreground="#7A8798" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="自动检测" Style="{StaticResource SecondaryButton}" Height="31" Click="DetectZotero_Click"/><Button Content="手动选择" Style="{StaticResource SecondaryButton}" Height="31" Margin="7,0,0,0" Click="BrowseZotero_Click"/></StackPanel></Grid>

                    <TextBlock Grid.Row="2" Text="Zotero 数据库" Style="{StaticResource SectionHeading}" VerticalAlignment="Center"/>
                    <TextBox x:Name="ZoteroBox" Grid.Row="2" Grid.Column="1" Height="34"/>

                    <TextBlock Grid.Row="4" Text="PDF 阅读器" Style="{StaticResource SectionHeading}" VerticalAlignment="Center"/>
                    <Grid Grid.Row="4" Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="SystemPdfCheck" Content="使用系统默认程序" VerticalAlignment="Center" Checked="SystemPdfCheck_Changed" Unchecked="SystemPdfCheck_Changed"/><TextBox x:Name="PdfReaderBox" Grid.Column="2" Height="34"/><Button Grid.Column="4" Content="选择 EXE" Style="{StaticResource SecondaryButton}" Height="34" Click="BrowsePdfReader_Click"/></Grid>

                    <TextBlock Grid.Row="6" Text="文献加载" Style="{StaticResource SectionHeading}" VerticalAlignment="Center"/>
                    <Grid Grid.Row="6" Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="14"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="14"/><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><RadioButton x:Name="CalibrationModeRadio" Content="校准模式" GroupName="ZoteroLoadMode" VerticalAlignment="Center" Checked="LoadMode_Changed"/><RadioButton x:Name="FullModeRadio" Grid.Column="2" Content="全量文献库" GroupName="ZoteroLoadMode" VerticalAlignment="Center" Checked="LoadMode_Changed"/><TextBox x:Name="CalibrationLimitBox" Grid.Column="4" Height="32"/><TextBlock Grid.Column="5" Text="默认 250 条；全量模式用于正式使用，列表仍保持虚拟化。" FontSize="11.2" Foreground="#77869A" VerticalAlignment="Center" Margin="9,0,0,0"/></Grid>
                </Grid>
            </Border>

            <Border Grid.Row="6" Style="{StaticResource SurfaceCard}" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Grid.ColumnSpan="2"><TextBlock Text="Python 与内置终端" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="仅发现并调用电脑已有环境，不携带 Python、Conda、uv 或第三方包。" FontSize="11.3" Foreground="#7A8798" Margin="0,3,0,0"/></StackPanel>
                    <TextBlock Grid.Row="2" Text="Conda" Style="{StaticResource SectionHeading}" VerticalAlignment="Center"/><Grid Grid.Row="2" Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="CondaBox" Height="34"/><Button Grid.Column="2" Content="选择" Style="{StaticResource SecondaryButton}" Height="34" Click="BrowseConda_Click"/></Grid>
                    <TextBlock Grid.Row="4" Text="uv" Style="{StaticResource SectionHeading}" VerticalAlignment="Center"/><Grid Grid.Row="4" Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="UvBox" Height="34"/><Button Grid.Column="2" Content="选择" Style="{StaticResource SecondaryButton}" Height="34" Click="BrowseUv_Click"/></Grid>
                    <TextBlock Grid.Row="6" Text="默认 Shell" Style="{StaticResource SectionHeading}" VerticalAlignment="Center"/><ComboBox x:Name="DefaultShellBox" Grid.Row="6" Grid.Column="1" Width="190" Height="34" HorizontalAlignment="Left"><ComboBoxItem Content="PowerShell" Tag="powershell"/><ComboBoxItem Content="CMD" Tag="cmd"/></ComboBox>
                    <TextBlock Grid.Row="8" Text="终端显示" Style="{StaticResource SectionHeading}" VerticalAlignment="Center"/><StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal"><TextBlock Text="字号" FontSize="12" Foreground="#5B6D84" VerticalAlignment="Center"/><ComboBox x:Name="TerminalFontSizeBox" Width="78" Height="32" Margin="8,0,20,0"><ComboBoxItem Content="12"/><ComboBoxItem Content="13"/><ComboBoxItem Content="14"/><ComboBoxItem Content="15"/><ComboBoxItem Content="16"/><ComboBoxItem Content="18"/></ComboBox><TextBlock Text="抽屉高度" FontSize="12" Foreground="#5B6D84" VerticalAlignment="Center"/><TextBox x:Name="TerminalHeightBox" Width="86" Height="32" Margin="8,0,0,0"/><TextBlock Text="px" FontSize="11.5" Foreground="#7B899C" VerticalAlignment="Center" Margin="5,0,0,0"/></StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Content="保存设置" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                    <Button Content="清除 Access 会话" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="ClearAccess_Click"/>
                    <Button Content="打开配置目录" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="OpenConfig_Click"/>
                </StackPanel>
                <TextBlock x:Name="SaveStatus" Grid.Column="2" FontSize="11.5" Foreground="#33805E" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
