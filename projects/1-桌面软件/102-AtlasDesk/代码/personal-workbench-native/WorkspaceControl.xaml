<UserControl x:Class="PersonalWorkbench.WorkspaceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PersonalWorkbench"
             FontFamily="{StaticResource AppFont}">
    <UserControl.Resources>
        <HierarchicalDataTemplate DataType="{x:Type local:WorkspaceNode}" ItemsSource="{Binding Children}">
            <Grid Margin="0,1" ToolTip="{Binding FullPath}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                    <Path x:Name="NodeIcon" Data="M6,3 H15 L20,8 V21 H6 Z M15,3 V8 H20"
                          Stroke="#7387A0" StrokeThickness="1.65" Fill="Transparent" StrokeLineJoin="Round"/>
                </Viewbox>
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.2" Foreground="#3E5068"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </Grid>
            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                    <Setter TargetName="NodeIcon" Property="Data" Value="M3,6 H9 L11,8 H21 V19 H3 Z"/>
                    <Setter TargetName="NodeIcon" Property="Stroke" Value="#52749D"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPdf}" Value="True">
                    <Setter TargetName="NodeIcon" Property="Stroke" Value="#C9525E"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMarkdown}" Value="True">
                    <Setter TargetName="NodeIcon" Property="Stroke" Value="#557FD2"/>
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>

        <Style x:Key="WorkspaceTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="Expander"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" Background="Transparent" BorderThickness="0"
                                          Width="18" Height="26">
                                <Path x:Name="Chevron" Data="M6,4 L10,8 L6,12" Stroke="#8190A3"
                                      StrokeThickness="1.5" Fill="Transparent"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </ToggleButton>
                            <Border x:Name="Row" Grid.Column="1" Background="Transparent" CornerRadius="7" Padding="5,3">
                                <ContentPresenter ContentSource="Header"/>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Grid.Column="1" Margin="13,27,0,0" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/></Trigger>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Chevron" Property="RenderTransform">
                                    <Setter.Value><RotateTransform Angle="90" CenterX="8" CenterY="8"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#F1F5FA"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#E6EFFF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="Expanded" Handler="FolderItem_Expanded"/>
        </Style>

        <Style x:Key="WorkspaceSegment" TargetType="RadioButton">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="50"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="FontSize" Value="11.3"/>
            <Setter Property="Foreground" Value="#66778D"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#F0F4F9"/></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Root" Property="Background" Value="White"/><Setter Property="Foreground" Value="#2868D7"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="7"/>
            <RowDefinition Height="22"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="本地工作区" Style="{StaticResource PageHeading}"/>
                <Border Background="#E9F2FF" CornerRadius="8" Padding="8,3" Margin="10,0,0,0">
                    <TextBlock x:Name="RootBadgeText" Text="尚未选择目录" FontSize="10.6" Foreground="#2E6FCB"/>
                </Border>
                <Border Background="#EAF8F2" CornerRadius="8" Padding="8,3" Margin="6,0,0,0">
                    <TextBlock x:Name="AutoSaveBadgeText" Text="自动保存" FontSize="10.6" Foreground="#2F7E60"/>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButton}" ToolTip="选择工作区目录" Click="ChooseRoot_Click">
                    <Viewbox Width="17" Height="17"><Path Style="{StaticResource ButtonIconPath}" Data="M3,6 H9 L11,8 H21 V19 H3 Z M12,12 H17 M14.5,9.5 V14.5"/></Viewbox>
                </Button>
                <Button Style="{StaticResource IconButton}" ToolTip="新建笔记" Margin="3,0,0,0" Click="NewNote_Click">
                    <Viewbox Width="17" Height="17"><Path Style="{StaticResource ButtonIconPath}" Data="M6,3 H15 L20,8 V21 H6 Z M15,3 V8 H20 M9,14 H17 M13,10 V18"/></Viewbox>
                </Button>
                <Button Style="{StaticResource IconButton}" ToolTip="在当前目录打开终端" Margin="3,0,0,0" Click="OpenTerminal_Click">
                    <Viewbox Width="17" Height="17"><Path Style="{StaticResource ButtonIconPath}" Data="M4,5 H20 V19 H4 Z M7,9 L10,12 L7,15 M12,15 H17"/></Viewbox>
                </Button>
                <Button Style="{StaticResource IconButton}" ToolTip="刷新资源树" Margin="3,0,0,0" Click="Refresh_Click">
                    <Viewbox Width="17" Height="17"><Path Style="{StaticResource ButtonIconPath}" Data="M19,8 A7,7 0 1 0 19,16 M19,8 V3 M19,8 H14"/></Viewbox>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="292"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource SurfaceCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="39"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="11,0,7,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="15" Height="15"><Path Data="M3,6 H9 L11,8 H21 V19 H3 Z" Stroke="#58708E" StrokeThickness="1.7" Fill="Transparent" StrokeLineJoin="Round"/></Viewbox>
                            <TextBlock x:Name="ExplorerTitleText" Text="资源管理器" Style="{StaticResource SectionHeading}" Margin="7,0,0,0"/>
                            <TextBlock x:Name="ExplorerCountText" FontSize="10.1" Foreground="#93A0B1" Margin="7,1,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButton}" Width="26" Height="26" ToolTip="新建目录" Click="NewFolder_Click">
                                <Viewbox Width="15" Height="15"><Path Style="{StaticResource ButtonIconPath}" Data="M3,6 H9 L11,8 H21 V19 H3 Z M12,13 H18 M15,10 V16"/></Viewbox>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Width="26" Height="26" ToolTip="用系统程序打开当前文件" Click="OpenExternal_Click">
                                <Viewbox Width="15" Height="15"><Path Style="{StaticResource ButtonIconPath}" Data="M8,5 H5 V20 H19 V17 M12,4 H20 V12 M20,4 L11,13"/></Viewbox>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Width="26" Height="26" ToolTip="在资源管理器中定位工作区" Click="RevealRoot_Click">
                                <Viewbox Width="15" Height="15"><Path Style="{StaticResource ButtonIconPath}" Data="M3,6 H9 L11,8 H21 V19 H3 Z M8,12 H16"/></Viewbox>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="8,4,8,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Height="29" Padding="8,4" FontSize="11.6"
                                 ToolTip="在整个工作区中递归搜索文件名" KeyDown="SearchBox_KeyDown"/>
                        <ComboBox x:Name="TypeFilter" Grid.Column="2" Height="29" Padding="5,2" FontSize="10.7"
                                  SelectionChanged="TypeFilter_SelectionChanged">
                            <ComboBoxItem Content="全部" Tag="all" IsSelected="True"/>
                            <ComboBoxItem Content="MD" Tag="markdown"/>
                            <ComboBoxItem Content="代码" Tag="code"/>
                            <ComboBoxItem Content="文本" Tag="text"/>
                            <ComboBoxItem Content="PDF" Tag="pdf"/>
                        </ComboBox>
                        <Button Grid.Column="4" Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="搜索" Click="Search_Click">
                            <Viewbox Width="15" Height="15"><Path Style="{StaticResource ButtonIconPath}" Data="M10.5,4 A6.5,6.5 0 1 0 10.5,17 A6.5,6.5 0 1 0 10.5,4 M15.2,15.2 L21,21"/></Viewbox>
                        </Button>
                    </Grid>

                    <Border Grid.Row="2" Background="#E7EDF4"/>
                    <TreeView x:Name="FolderTree" Grid.Row="3" BorderThickness="0" Background="Transparent" Padding="6,5"
                              ItemContainerStyle="{StaticResource WorkspaceTreeItemStyle}"
                              SelectedItemChanged="FolderTree_SelectedItemChanged"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SurfaceCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="13,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="DocumentTitleText" Text="选择一个文件" FontSize="13.4" FontWeight="SemiBold"
                                       Foreground="#293A51" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="DocumentPathText" FontSize="9.7" Foreground="#929FAF"
                                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#EEF2F7" CornerRadius="8" Padding="2" VerticalAlignment="Center" Margin="8,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="EditModeButton" Content="编辑" GroupName="EditorMode" Style="{StaticResource WorkspaceSegment}" IsChecked="True" Checked="EditorMode_Changed"/>
                                <RadioButton x:Name="SplitModeButton" Content="分栏" GroupName="EditorMode" Style="{StaticResource WorkspaceSegment}" Checked="EditorMode_Changed"/>
                                <RadioButton x:Name="PreviewModeButton" Content="预览" GroupName="EditorMode" Style="{StaticResource WorkspaceSegment}" Checked="EditorMode_Changed"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="SaveButton" Style="{StaticResource IconButton}" ToolTip="保存" IsEnabled="False" Click="Save_Click">
                                <Viewbox Width="16" Height="16"><Path Style="{StaticResource ButtonIconPath}" Data="M5,4 H18 L21,7 V20 H4 V4 Z M8,4 V10 H17 V4 M8,20 V14 H17 V20"/></Viewbox>
                            </Button>
                            <Button x:Name="RevealFileButton" Style="{StaticResource IconButton}" ToolTip="在资源管理器中定位文件" Margin="3,0,0,0" IsEnabled="False" Click="RevealFile_Click">
                                <Viewbox Width="16" Height="16"><Path Style="{StaticResource ButtonIconPath}" Data="M3,6 H9 L11,8 H21 V19 H3 Z M8,12 H16"/></Viewbox>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Background="#E6ECF3"/>
                    <Grid Grid.Row="2" x:Name="EditorHost">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="EditorColumn" Width="*"/>
                            <ColumnDefinition x:Name="PreviewDividerColumn" Width="0"/>
                            <ColumnDefinition x:Name="PreviewColumn" Width="0"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="EditorBox" VerticalContentAlignment="Top" AcceptsReturn="True" AcceptsTab="True"
                                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 BorderThickness="0" Background="#FCFDFE" Padding="16"
                                 FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" FontSize="14"
                                 TextChanged="EditorBox_TextChanged" PreviewKeyDown="EditorBox_PreviewKeyDown"/>
                        <GridSplitter x:Name="PreviewSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                                      Background="#E5EBF2" Visibility="Collapsed"/>
                        <FlowDocumentScrollViewer x:Name="PreviewViewer" Grid.Column="2" Background="White"
                                                  VerticalScrollBarVisibility="Auto" Padding="12" Visibility="Collapsed"/>
                        <Grid x:Name="EditorEmptyState" Background="#FBFCFE">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="340">
                                <Border Width="52" Height="52" CornerRadius="16" Background="#EDF3FF" HorizontalAlignment="Center">
                                    <Viewbox Width="24" Height="24"><Path Data="M6,3 H15 L20,8 V21 H6 Z M15,3 V8 H20 M9,13 H17 M9,17 H15" Stroke="#4B7EE8" StrokeThickness="1.7" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                                </Border>
                                <TextBlock Text="从左侧资源树选择文件" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" Margin="0,12,0,0"/>
                                <TextBlock Text="目录树、筛选和搜索都集中在左侧；PDF 与二进制文件仍交给系统程序打开。"
                                           Style="{StaticResource EmptyStateText}" TextAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="选择一个工作区目录开始。" FontSize="10.7" Foreground="#748399" VerticalAlignment="Center"/>
            <TextBlock x:Name="EncodingText" Grid.Column="1" Text="UTF-8" FontSize="10.4" Foreground="#96A2B2" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
