<Project>
  <Target Name="PublishDedicatedDashboardHost"
          AfterTargets="Publish"
          Condition="'$(AssemblyName)' == 'AtlasDesk'">
    <PropertyGroup>
      <DashboardHostProject>$(MSBuildThisFileDirectory)..\personal-workbench-dashboard-host\AtlasDesk.DashboardHost.csproj</DashboardHostProject>
      <DashboardHostPublishDirectory>$(PublishDir)DashboardHost\</DashboardHostPublishDirectory>
    </PropertyGroup>

    <Message Importance="high" Text="Publishing dedicated AtlasDesk DashboardHost to $(DashboardHostPublishDirectory)" />
    <Exec Command="dotnet publish &quot;$(DashboardHostProject)&quot; -c $(Configuration) -r $(RuntimeIdentifier) --self-contained false -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=false -o &quot;$(DashboardHostPublishDirectory)&quot;" />
    <Error Condition="!Exists('$(DashboardHostPublishDirectory)AtlasDesk.DashboardHost.exe')"
           Text="Dedicated DashboardHost publish output is missing: $(DashboardHostPublishDirectory)AtlasDesk.DashboardHost.exe" />
  </Target>
</Project>
