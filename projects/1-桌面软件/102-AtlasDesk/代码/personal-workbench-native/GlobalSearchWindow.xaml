<Window x:Class="PersonalWorkbench.GlobalSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="全局搜索" Width="760" Height="520" MinWidth="620" MinHeight="400"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource AppFont}" KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="SearchResultItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,1"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="9" Padding="10,8"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#F0F4FA"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Root" Property="Background" Value="#E7F0FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Border Margin="18" Background="#FCFDFEFA" BorderBrush="#D5DFEC" BorderThickness="1" CornerRadius="19">
        <Border.Effect><DropShadowEffect BlurRadius="38" ShadowDepth="9" Opacity="0.24" Color="#273A55"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="1"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
            <Grid Margin="18,11">
                <Grid.ColumnDefinitions><ColumnDefinition Width="35"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Viewbox Width="19" Height="19"><Path Style="{StaticResource VectorPathBase}" Stroke="#59718E" StrokeThickness="1.9" Data="M10.5,4 C6.9,4 4,6.9 4,10.5 C4,14.1 6.9,17 10.5,17 C14.1,17 17,14.1 17,10.5 C17,6.9 14.1,4 10.5,4 Z M15.3,15.3 L20,20"/></Viewbox>
                <TextBox x:Name="QueryBox" Grid.Column="1" BorderThickness="0" Background="Transparent" FontSize="16.5" FontWeight="SemiBold" Padding="0" VerticalContentAlignment="Center" TextChanged="QueryBox_TextChanged" PreviewKeyDown="QueryBox_PreviewKeyDown"/>
                <TextBlock x:Name="PlaceholderText" Grid.Column="1" Text="搜索页面、文件、文献或命令…" FontSize="15" Foreground="#9AA6B5" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <Border Grid.Column="2" Background="#EEF2F7" CornerRadius="6" Padding="8,4" VerticalAlignment="Center"><TextBlock Text="Esc" FontSize="10" Foreground="#77869A"/></Border>
            </Grid>
            <Border Grid.Row="1" Background="#E6ECF4"/>
            <Grid Grid.Row="2" Margin="10,7">
                <ListBox x:Name="ResultsList" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource SearchResultItem}" MouseDoubleClick="ResultsList_MouseDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Background="{Binding BadgeBackground}" CornerRadius="7" Padding="7,3" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding BadgeForeground}"/></Border>
                        <StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontSize="12.8" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="#8491A2" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/></StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding Hint}" FontSize="9.7" Foreground="#9AA5B3" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="没有找到结果" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="试试文件名、作者、论文标题或“终端”。" FontSize="11" Foreground="#8492A4" Margin="0,5,0,0"/></StackPanel>
            </Grid>
            <Border Grid.Row="3" Background="#F6F8FB" CornerRadius="0,0,19,19" BorderBrush="#E5EAF1" BorderThickness="0,1,0,0"><Grid Margin="16,0"><TextBlock x:Name="StatusText" Text="输入关键词开始搜索" FontSize="10.2" Foreground="#7E8B9C" VerticalAlignment="Center"/><TextBlock Text="↑↓ 选择    Enter 执行    Esc 关闭" FontSize="9.8" Foreground="#98A3B1" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
        </Grid>
    </Border>
</Window>
