<Window x:Class="PersonalWorkbench.GlobalSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AtlasDesk 快速打开" Width="720" Height="480" MinWidth="620" MinHeight="380"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource AppFont}" KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="SearchResultItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="7" Padding="9,7">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F2F5F9"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E8F0FC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="14" Background="#FDFEFE" BorderBrush="#D7DEE8" BorderThickness="1" CornerRadius="13">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="7" Opacity="0.19" Color="#25364E"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="36"/>
            </Grid.RowDefinitions>

            <Grid Margin="16,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Viewbox Width="18" Height="18">
                    <Path Style="{StaticResource VectorPathBase}" Stroke="#60738C" StrokeThickness="1.9"
                          Data="M10.5,4 C6.9,4 4,6.9 4,10.5 C4,14.1 6.9,17 10.5,17 C14.1,17 17,14.1 17,10.5 C17,6.9 14.1,4 10.5,4 Z M15.3,15.3 L20,20"/>
                </Viewbox>
                <TextBox x:Name="QueryBox" Grid.Column="1" BorderThickness="0" Background="Transparent"
                         FontSize="15.5" FontWeight="SemiBold" Padding="0" VerticalContentAlignment="Center"
                         TextChanged="QueryBox_TextChanged" PreviewKeyDown="QueryBox_PreviewKeyDown"/>
                <TextBlock x:Name="PlaceholderText" Grid.Column="1"
                           Text="搜索页面、当前项目、文件、命令或文献…"
                           FontSize="14" Foreground="#98A4B3" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <Border Grid.Column="2" Background="#F0F3F7" CornerRadius="5" Padding="7,3" VerticalAlignment="Center">
                    <TextBlock Text="Esc" FontSize="9.8" Foreground="#77869A"/>
                </Border>
            </Grid>

            <Border Grid.Row="1" Background="#E7EBF1"/>

            <Grid Grid.Row="2" Margin="9,6">
                <ListBox x:Name="ResultsList" BorderThickness="0" Background="Transparent"
                         ItemContainerStyle="{StaticResource SearchResultItem}"
                         MouseDoubleClick="ResultsList_MouseDoubleClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="68"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{Binding BadgeBackground}" CornerRadius="6" Padding="6,3"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Category}" FontSize="9.8" FontWeight="SemiBold"
                                               Foreground="{Binding BadgeForeground}"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontSize="12.4" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="9.8" Foreground="#8491A2"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Hint}" FontSize="9.4" Foreground="#98A3B1"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="没有找到结果" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="试试页面名、项目名、文件、命令或文献标题。"
                               FontSize="10.5" Foreground="#8492A4" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="3" Background="#F7F8FA" CornerRadius="0,0,13,13"
                    BorderBrush="#E5E9EF" BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#ECEFF4" CornerRadius="4" Padding="6,2" Margin="0,0,7,0">
                            <TextBlock Text="Ctrl+K" FontSize="9.3" Foreground="#6E7D91"/>
                        </Border>
                        <TextBlock Text="随时打开" FontSize="9.8" Foreground="#8995A5" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Grid.Column="1" Text="AtlasDesk 快速打开"
                               FontSize="10" Foreground="#7E8B9C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="↑↓ 选择    Enter 执行    Esc 关闭"
                               FontSize="9.5" Foreground="#98A3B1" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
