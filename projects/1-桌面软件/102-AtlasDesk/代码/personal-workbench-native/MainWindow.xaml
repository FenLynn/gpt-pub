                        <Border x:Name="DashboardEmpty" Background="#F7F9FC" Visibility="Collapsed"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="430"><Border Width="58" Height="58" Background="#EAF2FF" CornerRadius="18"><Viewbox Width="27" Height="27"><Path Data="M6,18 H18 C20.2,18 22,16.2 22,14 C22,11.8 20.2,10 18,10 C17.4,6.6 14.5,4 11,4 C7.8,4 5.1,6.2 4.3,9.2 C2.4,9.8 1,11.6 1,13.7 C1,16.1 3,18 6,18 Z" Stroke="#4285F4" StrokeThickness="1.8" StrokeLineJoin="Round" Fill="Transparent"/></Viewbox></Border><TextBlock x:Name="DashboardEmptyTitle" Text="尚未配置 Dashboard" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,5"/><TextBlock x:Name="DashboardEmptyDetail" Text="请在设置中填写 Cloudflare Pages 地址。" FontSize="13" Foreground="#718096" TextAlignment="Center"/><Button Content="打开设置" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,18,0,0" Click="OpenSettings_Click"/></StackPanel></Border>
                        <Border x:Name="DashboardError" Background="#F7F9FC" Visibility="Collapsed"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="540"><TextBlock Text="Dashboard 初始化失败" FontSize="18" FontWeight="SemiBold" Foreground="#B23B49" HorizontalAlignment="Center"/><TextBlock x:Name="DashboardErrorText" FontSize="13" Foreground="#5F6F84" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0"><Button Content="重试" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="RetryDashboard_Click"/><Button Content="打开日志目录" Style="{StaticResource SecondaryButton}" Click="OpenLogs_Click"/></StackPanel></StackPanel></Border>
                    </Grid>

                    <Grid x:Name="PlaceholderView" Visibility="Collapsed" Margin="24"><StackPanel><TextBlock x:Name="PlaceholderTitle" Text="工作区" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="PlaceholderSubtitle" Text="模块骨架已经就位。" FontSize="13.5" Foreground="#6B7A90" Margin="0,5,0,18"/><Border Background="White" BorderBrush="#E1E8F1" BorderThickness="1" CornerRadius="14" Padding="22"><TextBlock Text="这一轮优先确保 Dashboard、Access 登录、窗口与清晰度可靠。后续功能会在此架构上逐项接入。" FontSize="13" Foreground="#63738A" TextWrapping="Wrap"/></Border></StackPanel></Grid>

                    <ScrollViewer x:Name="SettingsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><Grid Margin="24" MaxWidth="900" HorizontalAlignment="Left"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="设置" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="手动绑定路径与服务，配置仅保存在本机。" FontSize="13.5" Foreground="#6B7A90" Margin="0,5,0,0"/></StackPanel><Border Grid.Row="2" Background="White" BorderBrush="#E1E8F1" BorderThickness="1" CornerRadius="14" Padding="22"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="520"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" Text="用户名" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox x:Name="UserNameBox" Grid.Row="0" Grid.Column="1" Height="38" Padding="10,7" FontSize="13" BorderBrush="#D8E1EC" Background="#FBFCFE"/><TextBlock Grid.Row="2" Text="Dashboard 名称" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox x:Name="DashboardNameBox" Grid.Row="2" Grid.Column="1" Height="38" Padding="10,7" FontSize="13" BorderBrush="#D8E1EC" Background="#FBFCFE"/><TextBlock Grid.Row="4" Text="Cloudflare Pages" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox x:Name="DashboardUrlBox" Grid.Row="4" Grid.Column="1" Height="38" Padding="10,7" FontSize="13" BorderBrush="#D8E1EC" Background="#FBFCFE"/><TextBlock Grid.Row="6" Text="工作区目录" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox x:Name="WorkspaceBox" Grid.Row="6" Grid.Column="1" Height="38" Padding="10,7" FontSize="13" BorderBrush="#D8E1EC" Background="#FBFCFE"/><TextBlock Grid.Row="8" Text="Zotero 数据库" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox x:Name="ZoteroBox" Grid.Row="8" Grid.Column="1" Height="38" Padding="10,7" FontSize="13" BorderBrush="#D8E1EC" Background="#FBFCFE"/><StackPanel Grid.Row="10" Grid.Column="1" Orientation="Horizontal"><Button Content="保存设置" Style="{StaticResource PrimaryButton}" Click="SaveSettings_Click"/><Button Content="清除 Access 会话" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="ClearSession_Click"/><Button Content="打开配置目录" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="OpenConfig_Click"/></StackPanel></Grid></Border></Grid></ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
