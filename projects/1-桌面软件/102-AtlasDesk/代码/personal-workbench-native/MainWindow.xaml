<Window x:Class="PersonalWorkbench.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AtlasDesk" Width="1460" Height="900" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen" Icon="{StaticResource AppWindowIcon}"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F5F8FC" Offset="0"/>
            <GradientStop Color="#EDF3FA" Offset="0.56"/>
            <GradientStop Color="#F5F1FA" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Grid x:Name="RootGrid" Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="224"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="Sidebar" Grid.Column="0" CornerRadius="18" BorderBrush="#DDE6F1" BorderThickness="1" Background="#FBFCFE">
            <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.09" Color="#43536A"/></Border.Effect>
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button x:Name="BrandToggleButton" Width="42" Height="42" HorizontalAlignment="Left" VerticalAlignment="Center"
                            ToolTip="折叠或展开目录" Cursor="Hand" BorderThickness="0" Background="Transparent" Click="ToggleSidebar_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Root" CornerRadius="12" Background="Transparent">
                                    <Grid>
                                        <Border Width="34" Height="34" CornerRadius="11">
                                            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#4C8CF8" Offset="0"/><GradientStop Color="#7777EB" Offset="1"/></LinearGradientBrush></Border.Background>
                                            <TextBlock Text="W" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Width="14" Height="14" CornerRadius="7" Background="White" HorizontalAlignment="Right" VerticalAlignment="Bottom" BorderBrush="#D8E2EF" BorderThickness="1">
                                            <Viewbox Width="8" Height="8"><Path Data="M5,3 L10,8 L5,13" Stroke="#4D6D9A" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/></Viewbox>
                                        </Border>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#EEF3FA"/></Trigger></ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <StackPanel x:Name="BrandText" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="AtlasDesk" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="Personal OS" FontSize="10.5" Foreground="#7B899B" Margin="0,1,0,0"/>
                    </StackPanel>
                </Grid>

                <Button Grid.Row="1" x:Name="CommandButton" Height="36" Margin="0,2" Background="#F1F5FA" BorderBrush="#E3EAF3" BorderThickness="1" Cursor="Hand" Click="CommandButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="10,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Viewbox Width="17" Height="17" HorizontalAlignment="Left"><Path Data="M10.5,4 C6.9,4 4,6.9 4,10.5 C4,14.1 6.9,17 10.5,17 C14.1,17 17,14.1 17,10.5 C17,6.9 14.1,4 10.5,4 Z M15.3,15.3 L20,20" Stroke="#73839A" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/></Viewbox>
                                    <TextBlock Grid.Column="1" Text="搜索或执行" FontSize="12.5" Foreground="#66758A" VerticalAlignment="Center"/>
                                    <Border Grid.Column="2" Background="#E6ECF4" CornerRadius="5" Padding="6,2"><TextBlock Text="Ctrl K" FontSize="9.5" Foreground="#8794A5"/></Border>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8">
                    <StackPanel>
                        <TextBlock x:Name="WorkLabel" Text="工作台" FontSize="10.5" Foreground="#9AA6B5" Margin="10,2,0,4"/>
                        <RadioButton x:Name="HomeNav" GroupName="Navigation" Style="{StaticResource NavButton}" IsChecked="True" Tag="home" ToolTip="首页" Checked="Navigation_Checked"><StackPanel Orientation="Horizontal"><Viewbox Width="18" Height="18" Margin="0,0,8,0"><Path Style="{StaticResource NavIconPath}" Data="M3,11 L12,3 L21,11 M5,10 L5,21 L19,21 L19,10 M9,21 L9,14 L15,14 L15,21"/></Viewbox><TextBlock x:Name="HomeNavText" Text="首页"/></StackPanel></RadioButton>
                        <RadioButton x:Name="WorkspaceNav" GroupName="Navigation" Style="{StaticResource NavButton}" Tag="workspace" ToolTip="工作区" Checked="Navigation_Checked"><StackPanel Orientation="Horizontal"><Viewbox Width="18" Height="18" Margin="0,0,8,0"><Path Style="{StaticResource NavIconPath}" Data="M4,4 H10 V10 H4 Z M14,4 H20 V10 H14 Z M4,14 H10 V20 H4 Z M14,14 H20 V20 H14 Z"/></Viewbox><TextBlock x:Name="WorkspaceNavText" Text="工作区"/></StackPanel></RadioButton>
                        <RadioButton x:Name="LibraryNav" GroupName="Navigation" Style="{StaticResource NavButton}" Tag="library" ToolTip="资料库" Checked="Navigation_Checked"><StackPanel Orientation="Horizontal"><Viewbox Width="18" Height="18" Margin="0,0,8,0"><Path Style="{StaticResource NavIconPath}" Data="M5,4 H16 C18,4 19,5 19,7 V20 H8 C6,20 5,19 5,17 Z M5,17 C6,16 7,16 8,16 H19 M8,8 H16 M8,12 H16"/></Viewbox><TextBlock x:Name="LibraryNavText" Text="资料库"/></StackPanel></RadioButton>
                        <TextBlock x:Name="AbilityLabel" Text="能力" FontSize="10.5" Foreground="#9AA6B5" Margin="10,12,0,4"/>
                        <RadioButton x:Name="DevelopmentNav" GroupName="Navigation" Style="{StaticResource NavButton}" Tag="development" ToolTip="开发" Checked="Navigation_Checked"><StackPanel Orientation="Horizontal"><Viewbox Width="18" Height="18" Margin="0,0,8,0"><Path Style="{StaticResource NavIconPath}" Data="M4,5 H20 V19 H4 Z M7,9 L10,12 L7,15 M12,15 H17"/></Viewbox><TextBlock x:Name="DevelopmentNavText" Text="开发"/></StackPanel></RadioButton>
                        <RadioButton x:Name="ToolsNav" GroupName="Navigation" Style="{StaticResource NavButton}" Tag="tools" ToolTip="工具" Checked="Navigation_Checked"><StackPanel Orientation="Horizontal"><Viewbox Width="18" Height="18" Margin="0,0,8,0"><Path Style="{StaticResource NavIconPath}" Data="M4,7 H20 M4,12 H20 M4,17 H20 M8,5 V9 M15,10 V14 M10,15 V19"/></Viewbox><TextBlock x:Name="ToolsNavText" Text="工具"/></StackPanel></RadioButton>
                        <RadioButton x:Name="DashboardNav" GroupName="Navigation" Style="{StaticResource NavButton}" Tag="dashboard" ToolTip="Dashboard" Checked="Navigation_Checked"><StackPanel Orientation="Horizontal"><Viewbox Width="18" Height="18" Margin="0,0,8,0"><Path Style="{StaticResource NavIconPath}" Data="M6,18 H18 C20.2,18 22,16.2 22,14 C22,11.8 20.2,10 18,10 C17.4,6.6 14.5,4 11,4 C7.8,4 5.1,6.2 4.3,9.2 C2.4,9.8 1,11.6 1,13.7 C1,16.1 3,18 6,18 Z"/></Viewbox><TextBlock x:Name="DashboardNavText" Text="Dashboard"/></StackPanel></RadioButton>
                        <RadioButton x:Name="TasksNav" GroupName="Navigation" Style="{StaticResource NavButton}" Tag="tasks" ToolTip="任务" Checked="Navigation_Checked"><StackPanel Orientation="Horizontal"><Viewbox Width="18" Height="18" Margin="0,0,8,0"><Path Style="{StaticResource NavIconPath}" Data="M9,6 H20 M9,12 H20 M9,18 H20 M3,6 L4.5,7.5 L7,4.5 M3,12 L4.5,13.5 L7,10.5 M3,18 L4.5,19.5 L7,16.5"/></Viewbox><TextBlock x:Name="TasksNavText" Text="任务"/></StackPanel></RadioButton>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="3">
                    <RadioButton x:Name="SettingsNav" GroupName="Navigation" Style="{StaticResource NavButton}" Tag="settings" ToolTip="设置" Checked="Navigation_Checked"><StackPanel Orientation="Horizontal"><Viewbox Width="18" Height="18" Margin="0,0,8,0"><Path Style="{StaticResource NavIconPath}" Data="M12,8 A4,4 0 1 0 12,16 A4,4 0 1 0 12,8 M12,3 V6 M12,18 V21 M3,12 H6 M18,12 H21 M5.6,5.6 L7.7,7.7 M16.3,16.3 L18.4,18.4 M18.4,5.6 L16.3,7.7 M7.7,16.3 L5.6,18.4"/></Viewbox><TextBlock x:Name="SettingsNavText" Text="设置"/></StackPanel></RadioButton>
                    <Border x:Name="UserCard" Height="48" Margin="0,6,0,0" Background="#F3F6FA" CornerRadius="11" Padding="7" ToolTip="Fenlynn · 本地工作台">
                        <Grid>
                            <Border x:Name="UserAvatar" Width="30" Height="30" CornerRadius="9" Background="#6688F0" VerticalAlignment="Center"><Border.Style><Style TargetType="Border"><Setter Property="HorizontalAlignment" Value="Left"/><Style.Triggers><DataTrigger Binding="{Binding Visibility, ElementName=UserText}" Value="Collapsed"><Setter Property="HorizontalAlignment" Value="Center"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="F" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel x:Name="UserText" Margin="40,0,16,0" VerticalAlignment="Center"><TextBlock x:Name="UserNameText" Text="Fenlynn" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="本地工作台" FontSize="10" Foreground="#8A97A8"/></StackPanel>
                            <Ellipse Width="7" Height="7" Fill="#31B675" Stroke="White" StrokeThickness="1.4" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="2" CornerRadius="18" BorderBrush="#DDE6F1" BorderThickness="1" Background="#FBFCFEF2" ClipToBounds="True">
            <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.08" Color="#43536A"/></Border.Effect>
            <Grid>
                <Grid.RowDefinitions><RowDefinition x:Name="TopBarRow" Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid x:Name="TopBar" Grid.Row="0" Background="#FAFCFE">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel x:Name="BrowserControls" Orientation="Horizontal" Margin="8,0,4,0" VerticalAlignment="Center" Visibility="Collapsed">
                        <Button Style="{StaticResource IconButton}" ToolTip="后退" Click="Back_Click"><Viewbox Width="16" Height="16"><Path Style="{StaticResource ButtonIconPath}" Data="M19,12 H5 M11,6 L5,12 L11,18"/></Viewbox></Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="前进" Click="Forward_Click"><Viewbox Width="16" Height="16"><Path Style="{StaticResource ButtonIconPath}" Data="M5,12 H19 M13,6 L19,12 L13,18"/></Viewbox></Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="刷新" Click="Refresh_Click"><Viewbox Width="16" Height="16"><Path Style="{StaticResource ButtonIconPath}" Data="M20,11 C19.5,7 16.1,4 12,4 C7.6,4 4,7.6 4,12 C4,16.4 7.6,20 12,20 C15,20 17.6,18.3 19,16 M20,11 V5 M20,11 H14"/></Viewbox></Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="Dashboard 首页" Click="DashboardHome_Click"><Viewbox Width="16" Height="16"><Path Style="{StaticResource ButtonIconPath}" Data="M3,11 L12,3 L21,11 M5,10 L5,21 L19,21 L19,10 M9,21 L9,14 L15,14 L15,21"/></Viewbox></Button>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,8,0">
                        <TextBlock x:Name="PageTitle" Text="首页" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PageSubtitle" Text="  ·  AtlasDesk" FontSize="11.5" Foreground="#8390A1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,8,0">
                        <Border x:Name="AccessBadge" Background="#EAF8F2" CornerRadius="8" Padding="8,4" Margin="0,0,4,0" Visibility="Collapsed"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#25A46C" Margin="0,0,5,0" VerticalAlignment="Center"/><TextBlock x:Name="AccessStatusText" Text="会话目录已启用" FontSize="11" Foreground="#2F7E60"/></StackPanel></Border>
                        <Button x:Name="PopoutButton" Style="{StaticResource IconButton}" ToolTip="弹出 Dashboard" Click="Popout_Click" Visibility="Collapsed"><Viewbox Width="16" Height="16"><Path Style="{StaticResource ButtonIconPath}" Data="M14,4 H20 V10 M20,4 L11,13 M18,13 V20 H4 V6 H11"/></Viewbox></Button>
                        <Button x:Name="FullscreenButton" Style="{StaticResource IconButton}" ToolTip="全屏" Click="Fullscreen_Click" Visibility="Collapsed"><Viewbox Width="16" Height="16"><Path Style="{StaticResource ButtonIconPath}" Data="M9,4 H4 V9 M15,4 H20 V9 M20,15 V20 H15 M9,20 H4 V15"/></Viewbox></Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="命令面板" Click="CommandButton_Click"><Viewbox Width="16" Height="16"><Path Style="{StaticResource ButtonIconPath}" Data="M10.5,4 C6.9,4 4,6.9 4,10.5 C4,14.1 6.9,17 10.5,17 C14.1,17 17,14.1 17,10.5 C17,6.9 14.1,4 10.5,4 Z M15.3,15.3 L20,20"/></Viewbox></Button>
                    </StackPanel>
                    <ProgressBar x:Name="NavigationProgress" Grid.ColumnSpan="3" Height="2" VerticalAlignment="Bottom" IsIndeterminate="True" Foreground="#4285F4" Visibility="Collapsed"/>
                </Grid>

                <Grid Grid.Row="1" x:Name="ContentGrid" Background="#F7F9FC">
                    <ScrollViewer x:Name="HomeView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="20">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel><TextBlock Text="个人工作台" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="项目、资料、开发环境和 Cloudflare Dashboard 的统一入口。" FontSize="13.5" Foreground="#6B7A90" Margin="0,4,0,0"/></StackPanel>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Height="174" Style="{StaticResource HomeCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Cloudflare Dashboard" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="页面后台保持 · Access 会话持久化" FontSize="11.5" Foreground="#728197" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Row="1" Text="切换到其他模块时不重新载入，回来后保留原页面、滚动位置与运行状态。" FontSize="12.5" Foreground="#65758B" TextWrapping="Wrap" Margin="0,12,0,0"/><Button Grid.Row="2" Content="打开 Dashboard" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="OpenDashboard_Click"/></Grid></Border>
                                <Border Grid.Column="2" Height="174" Style="{StaticResource HomeCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Python 环境" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="HomePythonStatus" Text="等待首次检测" FontSize="11.5" Foreground="#728197" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Row="1" Text="只读取现有 Conda、uv、venv 与系统 Python，不安装或携带大型库。" FontSize="12.5" Foreground="#65758B" TextWrapping="Wrap" Margin="0,12,0,0"/><Button Grid.Row="2" Content="查看环境" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="OpenDevelopment_Click"/></Grid></Border>
                                <Border Grid.Column="4" Height="174" Style="{StaticResource HomeCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Zotero 文献库" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="HomeZoteroStatus" Text="等待首次定位" FontSize="11.5" Foreground="#728197" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Row="1" Text="直接只读检索 zotero.sqlite，并用本机 PDF 阅读器打开附件。" FontSize="12.5" Foreground="#65758B" TextWrapping="Wrap" Margin="0,12,0,0"/><Button Grid.Row="2" Content="搜索文献" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="OpenLibrary_Click"/></Grid></Border>
                            </Grid>
                            <Border Grid.Row="4" Background="White" BorderBrush="#E1E8F1" BorderThickness="1" CornerRadius="14" Padding="15"><TextBlock Text="v0.4.0 开始进入真实功能阶段：先做只读、轻量、可手动配置的文献与 Python 环境入口。" FontSize="12.5" Foreground="#65758B"/></Border>
                        </Grid>
                    </ScrollViewer>

                    <Grid x:Name="DashboardView" Visibility="Collapsed">
                        <Grid x:Name="DashboardHost" Background="White"/>
                        <Border x:Name="DashboardEmpty" Background="#F7F9FC" Visibility="Collapsed"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="430"><TextBlock x:Name="DashboardEmptyTitle" Text="尚未配置 Dashboard" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="DashboardEmptyDetail" Text="请在设置中填写 Cloudflare Pages 地址。" FontSize="13" Foreground="#718096" TextAlignment="Center" Margin="0,8,0,0"/><Button Content="打开设置" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,18,0,0" Click="OpenSettings_Click"/></StackPanel></Border>
                        <Border x:Name="DashboardError" Background="#F7F9FC" Visibility="Collapsed"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="540"><TextBlock Text="Dashboard 初始化失败" FontSize="18" FontWeight="SemiBold" Foreground="#B23B49" HorizontalAlignment="Center"/><TextBlock x:Name="DashboardErrorText" FontSize="13" Foreground="#5F6F84" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0"><Button Content="重试" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="RetryDashboard_Click"/><Button Content="打开日志目录" Style="{StaticResource SecondaryButton}" Click="OpenLogs_Click"/></StackPanel></StackPanel></Border>
                    </Grid>

                    <Grid x:Name="LibraryView" Visibility="Collapsed" Margin="16">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Zotero 文献库" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="直接读取本机数据库，只读检索，不启动 Zotero。" FontSize="12.5" Foreground="#6B7A90" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="自动定位" Style="{StaticResource SecondaryButton}" Click="ZoteroDetect_Click"/><Button Content="手动选择" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="ZoteroBrowse_Click"/></StackPanel></Grid>
                        <Border Grid.Row="2" Background="White" BorderBrush="#E1E8F1" BorderThickness="1" CornerRadius="12" Padding="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ZoteroPathText" Height="34" IsReadOnly="True" Padding="9,6" BorderBrush="#D8E1EC" Background="#F8FAFD" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBox x:Name="ZoteroSearchBox" Grid.Column="2" Height="34" Padding="9,6" BorderBrush="#D8E1EC" Background="#FBFCFE" FontSize="13" ToolTip="标题、作者、期刊、DOI、摘要" KeyDown="ZoteroSearchBox_KeyDown"/><Button Grid.Column="4" Content="搜索" Style="{StaticResource PrimaryButton}" Click="ZoteroSearch_Click"/></Grid></Border>
                        <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                            <Border Background="White" BorderBrush="#E1E8F1" BorderThickness="1" CornerRadius="12" Padding="8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="ZoteroStatusText" Text="请自动定位或手动选择 zotero.sqlite。" FontSize="11.5" Foreground="#748296" Margin="4,2"/><ListView x:Name="ZoteroResults" Grid.Row="2" BorderThickness="0" Background="Transparent" SelectionChanged="ZoteroResults_SelectionChanged"><ListView.View><GridView><GridViewColumn Header="标题" Width="420" DisplayMemberBinding="{Binding DisplayTitle}"/><GridViewColumn Header="作者" Width="170" DisplayMemberBinding="{Binding Authors}"/><GridViewColumn Header="年份" Width="60" DisplayMemberBinding="{Binding Year}"/><GridViewColumn Header="期刊 / 来源" Width="180" DisplayMemberBinding="{Binding Publication}"/></GridView></ListView.View></ListView></Grid></Border>
                            <Border Grid.Column="2" Background="White" BorderBrush="#E1E8F1" BorderThickness="1" CornerRadius="12" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="ZoteroDetailTitle" Text="选择一篇文献" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="ZoteroDetailAuthors" FontSize="12.5" Foreground="#607189" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBlock x:Name="ZoteroDetailPublication" FontSize="12" Foreground="#748296" Margin="0,6,0,0" TextWrapping="Wrap"/><TextBlock x:Name="ZoteroDetailDoi" FontSize="12" Foreground="#3C6FB4" Margin="0,6,0,0" TextWrapping="Wrap"/><Border Height="1" Background="#E6ECF3" Margin="0,14"/><TextBlock Text="摘要" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="ZoteroDetailAbstract" Text="暂无摘要" FontSize="12.5" Foreground="#5F6F84" TextWrapping="Wrap" LineHeight="20" Margin="0,7,0,0"/><StackPanel Orientation="Horizontal" Margin="0,16,0,0"><Button x:Name="OpenPdfButton" Content="打开 PDF" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="OpenSelectedPdf_Click"/><Button x:Name="CopyDoiButton" Content="复制 DOI" Style="{StaticResource SecondaryButton}" IsEnabled="False" Margin="8,0,0,0" Click="CopySelectedDoi_Click"/></StackPanel></StackPanel></ScrollViewer></Border>
                        </Grid>
                    </Grid>

                    <Grid x:Name="DevelopmentView" Visibility="Collapsed" Margin="16">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Python 环境" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="兼容 Conda 与 uv，只发现和调用现有环境，不安装任何 Python 库。" FontSize="12.5" Foreground="#6B7A90" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="1" Content="刷新环境" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Click="RefreshPython_Click"/></Grid>
                        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="White" BorderBrush="#E1E8F1" BorderThickness="1" CornerRadius="12" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Conda" FontSize="13.5" FontWeight="SemiBold"/><TextBlock x:Name="CondaStatusText" Text="尚未检测" FontSize="11.5" Foreground="#748296" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><Button Grid.Column="1" Content="手动指定" Style="{StaticResource SecondaryButton}" Click="BrowseConda_Click"/></Grid></Border><Border Grid.Column="2" Background="White" BorderBrush="#E1E8F1" BorderThickness="1" CornerRadius="12" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="uv" FontSize="13.5" FontWeight="SemiBold"/><TextBlock x:Name="UvStatusText" Text="尚未检测" FontSize="11.5" Foreground="#748296" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><Button Grid.Column="1" Content="手动指定" Style="{StaticResource SecondaryButton}" Click="BrowseUv_Click"/></Grid></Border></Grid>
                        <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><Border Background="White" BorderBrush="#E1E8F1" BorderThickness="1" CornerRadius="12" Padding="8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="PythonStatusText" Text="点击“刷新环境”开始检测。" FontSize="11.5" Foreground="#748296" Margin="4,2"/><ListView x:Name="PythonEnvironments" Grid.Row="2" BorderThickness="0" Background="Transparent" SelectionChanged="PythonEnvironments_SelectionChanged"><ListView.View><GridView><GridViewColumn Header="环境" Width="170" DisplayMemberBinding="{Binding DisplayName}"/><GridViewColumn Header="类型" Width="100" DisplayMemberBinding="{Binding KindLabel}"/><GridViewColumn Header="Python" Width="90" DisplayMemberBinding="{Binding Version}"/><GridViewColumn Header="路径" Width="360" DisplayMemberBinding="{Binding Prefix}"/></GridView></ListView.View></ListView></Grid></Border><Border Grid.Column="2" Background="White" BorderBrush="#E1E8F1" BorderThickness="1" CornerRadius="12" Padding="16"><StackPanel><TextBlock x:Name="PythonDetailName" Text="选择一个 Python 环境" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="PythonDetailKind" FontSize="12.5" Foreground="#607189" Margin="0,8,0,0"/><TextBlock Text="解释器" FontSize="11" Foreground="#8793A4" Margin="0,16,0,0"/><TextBlock x:Name="PythonDetailPath" FontSize="12" Foreground="#4F6077" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="来源" FontSize="11" Foreground="#8793A4" Margin="0,12,0,0"/><TextBlock x:Name="PythonDetailSource" FontSize="12" Foreground="#4F6077" Margin="0,4,0,0"/><WrapPanel Margin="0,18,0,0"><Button x:Name="OpenPythonTerminalButton" Content="打开终端" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="OpenPythonTerminal_Click"/><Button x:Name="CopyPythonPathButton" Content="复制路径" Style="{StaticResource SecondaryButton}" IsEnabled="False" Margin="8,0,0,0" Click="CopyPythonPath_Click"/><Button x:Name="OpenPythonFolderButton" Content="打开目录" Style="{StaticResource SecondaryButton}" IsEnabled="False" Margin="8,0,0,0" Click="OpenPythonFolder_Click"/></WrapPanel></StackPanel></Border></Grid>
                    </Grid>

                    <Grid x:Name="PlaceholderView" Visibility="Collapsed" Margin="22"><StackPanel><TextBlock x:Name="PlaceholderTitle" Text="工作区" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="PlaceholderSubtitle" Text="模块骨架已经就位。" FontSize="13.5" Foreground="#6B7A90" Margin="0,5,0,18"/><Border Background="White" BorderBrush="#E1E8F1" BorderThickness="1" CornerRadius="14" Padding="22"><TextBlock Text="后续功能会继续沿用当前的轻量适配器架构逐项接入。" FontSize="13" Foreground="#63738A" TextWrapping="Wrap"/></Border></StackPanel></Grid>

                    <ScrollViewer x:Name="SettingsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="22" MaxWidth="940" HorizontalAlignment="Left"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="设置" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="自动检测只是辅助，所有路径都可以手动指定。" FontSize="13.5" Foreground="#6B7A90" Margin="0,5,0,0"/></StackPanel><Border Grid.Row="2" Background="White" BorderBrush="#E1E8F1" BorderThickness="1" CornerRadius="14" Padding="20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="600"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="用户名" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox x:Name="UserNameBox" Grid.Row="0" Grid.Column="1" Height="36" Padding="10,7" FontSize="13" BorderBrush="#D8E1EC" Background="#FBFCFE"/>
                            <TextBlock Grid.Row="2" Text="Dashboard 名称" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox x:Name="DashboardNameBox" Grid.Row="2" Grid.Column="1" Height="36" Padding="10,7" FontSize="13" BorderBrush="#D8E1EC" Background="#FBFCFE"/>
                            <TextBlock Grid.Row="4" Text="Cloudflare Pages" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox x:Name="DashboardUrlBox" Grid.Row="4" Grid.Column="1" Height="36" Padding="10,7" FontSize="13" BorderBrush="#D8E1EC" Background="#FBFCFE"/>
                            <TextBlock Grid.Row="6" Text="工作区目录" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox x:Name="WorkspaceBox" Grid.Row="6" Grid.Column="1" Height="36" Padding="10,7" FontSize="13" BorderBrush="#D8E1EC" Background="#FBFCFE"/>
                            <TextBlock Grid.Row="8" Text="Zotero 数据库" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox x:Name="ZoteroBox" Grid.Row="8" Grid.Column="1" Height="36" Padding="10,7" FontSize="13" BorderBrush="#D8E1EC" Background="#FBFCFE"/>
                            <TextBlock Grid.Row="10" Text="Conda 可执行文件" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox x:Name="CondaBox" Grid.Row="10" Grid.Column="1" Height="36" Padding="10,7" FontSize="13" BorderBrush="#D8E1EC" Background="#FBFCFE"/>
                            <TextBlock Grid.Row="12" Text="uv 可执行文件" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox x:Name="UvBox" Grid.Row="12" Grid.Column="1" Height="36" Padding="10,7" FontSize="13" BorderBrush="#D8E1EC" Background="#FBFCFE"/>
                            <StackPanel Grid.Row="14" Grid.Column="1" Orientation="Horizontal"><Button Content="保存设置" Style="{StaticResource PrimaryButton}" Click="SaveSettings_Click"/><Button Content="清除 Access 会话" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="ClearSession_Click"/><Button Content="打开配置目录" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="OpenConfig_Click"/></StackPanel>
                        </Grid></Border></Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
