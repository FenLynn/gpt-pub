<Window x:Class="PersonalWorkbench.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personal Workbench" Width="1460" Height="900" MinWidth="1020" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Icon="{StaticResource AppWindowIcon}"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F5F8FC" Offset="0"/>
            <GradientStop Color="#EDF3FA" Offset="0.56"/>
            <GradientStop Color="#F5F1FA" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Grid x:Name="RootGrid" Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="224"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="Sidebar" Grid.Column="0" CornerRadius="18" BorderBrush="#DDE6F1" BorderThickness="1" Background="#F9FBFEDD">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.09" Color="#43536A"/>
            </Border.Effect>
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BrandToggleButton" Width="42" Height="42" HorizontalAlignment="Left"
                            VerticalAlignment="Center" ToolTip="折叠或展开目录" Cursor="Hand"
                            BorderThickness="0" Background="Transparent" Click="ToggleSidebar_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Root" CornerRadius="12" Background="Transparent">
                                    <Grid>
                                        <Border Width="34" Height="34" CornerRadius="11">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#4C8CF8" Offset="0"/>
                                                    <GradientStop Color="#7777EB" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="W" Foreground="White" FontSize="15" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Width="14" Height="14" CornerRadius="7" Background="White"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                BorderBrush="#D8E2EF" BorderThickness="1">
                                            <Viewbox Width="8" Height="8">
                                                <Path Data="M5,3 L10,8 L5,13" Stroke="#4D6D9A" StrokeThickness="2"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" Fill="Transparent"/>
                                            </Viewbox>
                                        </Border>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="#EEF3FA"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <StackPanel x:Name="BrandText" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Workbench" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="Personal OS" FontSize="10.5" Foreground="#7B899B" Margin="0,1,0,0"/>
                    </StackPanel>
                </Grid>

                <Button Grid.Row="1" x:Name="CommandButton" Height="36" Margin="0,2,0,2"
                        Background="#F1F5FA" BorderBrush="#E3EAF3" BorderThickness="1"
                        Cursor="Hand" Click="CommandButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="10,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Width="17" Height="17" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <Path Data="M10.5,4 C6.9,4 4,6.9 4,10.5 C4,14.1 6.9,17 10.5,17 C14.1,17 17,14.1 17,10.5 C17,6.9 14.1,4 10.5,4 Z M15.3,15.3 L20,20"
                                              Stroke="#73839A" StrokeThickness="1.8" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                                    </Viewbox>
                                    <TextBlock x:Name="SearchText" Grid.Column="1" Text="搜索或执行" FontSize="12.5"
                                               Foreground="#66758A" VerticalAlignment="Center"/>
                                    <Border x:Name="Shortcut" Grid.Column="2" Background="#E6ECF4" CornerRadius="5"
                                            Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="Ctrl K" FontSize="9.5" Foreground="#8794A5"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Margin="0,8,0,8">
                    <StackPanel>
                        <TextBlock x:Name="WorkLabel" Text="工作台" FontSize="10.5" Foreground="#9AA6B5" Margin="10,2,0,4"/>

                        <RadioButton x:Name="HomeNav" GroupName="Navigation" Style="{StaticResource NavButton}"
                                     IsChecked="True" Tag="home" ToolTip="首页" Checked="Navigation_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                                    <Path Style="{StaticResource NavIconPath}" Data="M3,11 L12,3 L21,11 M5,10 L5,21 L19,21 L19,10 M9,21 L9,14 L15,14 L15,21"/>
                                </Viewbox>
                                <TextBlock x:Name="HomeNavText" Text="首页"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="WorkspaceNav" GroupName="Navigation" Style="{StaticResource NavButton}"
                                     Tag="workspace" ToolTip="工作区" Checked="Navigation_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                                    <Path Style="{StaticResource NavIconPath}" Data="M4,4 H10 V10 H4 Z M14,4 H20 V10 H14 Z M4,14 H10 V20 H4 Z M14,14 H20 V20 H14 Z"/>
                                </Viewbox>
                                <TextBlock x:Name="WorkspaceNavText" Text="工作区"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="LibraryNav" GroupName="Navigation" Style="{StaticResource NavButton}"
                                     Tag="library" ToolTip="资料库" Checked="Navigation_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                                    <Path Style="{StaticResource NavIconPath}" Data="M5,4 H16 C18,4 19,5 19,7 V20 H8 C6,20 5,19 5,17 Z M5,17 C6,16 7,16 8,16 H19 M8,8 H16 M8,12 H16"/>
                                </Viewbox>
                                <TextBlock x:Name="LibraryNavText" Text="资料库"/>
                            </StackPanel>
                        </RadioButton>

                        <TextBlock x:Name="AbilityLabel" Text="能力" FontSize="10.5" Foreground="#9AA6B5" Margin="10,12,0,4"/>

                        <RadioButton x:Name="DevelopmentNav" GroupName="Navigation" Style="{StaticResource NavButton}"
                                     Tag="development" ToolTip="开发" Checked="Navigation_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                                    <Path Style="{StaticResource NavIconPath}" Data="M4,5 H20 V19 H4 Z M7,9 L10,12 L7,15 M12,15 H17"/>
                                </Viewbox>
                                <TextBlock x:Name="DevelopmentNavText" Text="开发"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="ToolsNav" GroupName="Navigation" Style="{StaticResource NavButton}"
                                     Tag="tools" ToolTip="工具" Checked="Navigation_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                                    <Path Style="{StaticResource NavIconPath}" Data="M4,7 H20 M4,12 H20 M4,17 H20 M8,5 V9 M15,10 V14 M10,15 V19"/>
                                </Viewbox>
                                <TextBlock x:Name="ToolsNavText" Text="工具"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="DashboardNav" GroupName="Navigation" Style="{StaticResource NavButton}"
                                     Tag="dashboard" ToolTip="Dashboard" Checked="Navigation_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                                    <Path Style="{StaticResource NavIconPath}" Data="M6,18 H18 C20.2,18 22,16.2 22,14 C22,11.8 20.2,10 18,10 C17.4,6.6 14.5,4 11,4 C7.8,4 5.1,6.2 4.3,9.2 C2.4,9.8 1,11.6 1,13.7 C1,16.1 3,18 6,18 Z"/>
                                </Viewbox>
                                <TextBlock x:Name="DashboardNavText" Text="Dashboard"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="TasksNav" GroupName="Navigation" Style="{StaticResource NavButton}"
                                     Tag="tasks" ToolTip="任务" Checked="Navigation_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                                    <Path Style="{StaticResource NavIconPath}" Data="M9,6 H20 M9,12 H20 M9,18 H20 M3,6 L4.5,7.5 L7,4.5 M3,12 L4.5,13.5 L7,10.5 M3,18 L4.5,19.5 L7,16.5"/>
                                </Viewbox>
                                <TextBlock x:Name="TasksNavText" Text="任务"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="3">
                    <RadioButton x:Name="SettingsNav" GroupName="Navigation" Style="{StaticResource NavButton}"
                                 Tag="settings" ToolTip="设置" Checked="Navigation_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                                <Path Style="{StaticResource NavIconPath}"
                                      Data="M12,8 A4,4 0 1 0 12,16 A4,4 0 1 0 12,8 M12,3 V6 M12,18 V21 M3,12 H6 M18,12 H21 M5.6,5.6 L7.7,7.7 M16.3,16.3 L18.4,18.4 M18.4,5.6 L16.3,7.7 M7.7,16.3 L5.6,18.4"/>
                            </Viewbox>
                            <TextBlock x:Name="SettingsNavText" Text="设置"/>
                        </StackPanel>
                    </RadioButton>

                    <Border x:Name="UserCard" Height="48" Margin="0,6,0,0" Background="#F3F6FA"
                            CornerRadius="11" Padding="7" ToolTip="Fenlynn · 本地工作台">
                        <Grid>
                            <Border x:Name="UserAvatar" Width="30" Height="30" CornerRadius="9" Background="#6688F0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=UserText}" Value="Collapsed">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="F" Foreground="White" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel x:Name="UserText" Margin="40,0,16,0" VerticalAlignment="Center">
                                <TextBlock x:Name="UserNameText" Text="Fenlynn" FontSize="12.5" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="本地工作台" FontSize="10" Foreground="#8A97A8"/>
                            </StackPanel>
                            <Ellipse Width="7" Height="7" Fill="#31B675" Stroke="White" StrokeThickness="1.4">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=UserText}" Value="Collapsed">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Bottom"/>
                                                <Setter Property="Margin" Value="22,0,0,2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="2" CornerRadius="18" BorderBrush="#DDE6F1" BorderThickness="1"
                Background="#FBFCFEF2" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.08" Color="#43536A"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="TopBarRow" Height="52"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid x:Name="TopBar" Grid.Row="0" Background="#FAFCFE">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="BrowserControls" Orientation="Horizontal" Margin="10,0,5,0"
                                VerticalAlignment="Center" Visibility="Collapsed">
                        <Button Style="{StaticResource IconButton}" ToolTip="后退" Click="Back_Click">
                            <Viewbox Width="17" Height="17"><Path Style="{StaticResource ButtonIconPath}" Data="M19,12 H5 M11,6 L5,12 L11,18"/></Viewbox>
                        </Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="前进" Click="Forward_Click">
                            <Viewbox Width="17" Height="17"><Path Style="{StaticResource ButtonIconPath}" Data="M5,12 H19 M13,6 L19,12 L13,18"/></Viewbox>
                        </Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="刷新" Click="Refresh_Click">
                            <Viewbox Width="17" Height="17"><Path Style="{StaticResource ButtonIconPath}" Data="M20,11 C19.5,7 16.1,4 12,4 C7.6,4 4,7.6 4,12 C4,16.4 7.6,20 12,20 C15,20 17.6,18.3 19,16 M20,11 V5 M20,11 H14"/></Viewbox>
                        </Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="Dashboard 首页" Click="DashboardHome_Click">
                            <Viewbox Width="17" Height="17"><Path Style="{StaticResource ButtonIconPath}" Data="M3,11 L12,3 L21,11 M5,10 L5,21 L19,21 L19,10 M9,21 L9,14 L15,14 L15,21"/></Viewbox>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,10,0">
                        <TextBlock x:Name="PageTitle" Text="首页" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PageSubtitle" Text="  ·  Personal Workbench" FontSize="12"
                                   Foreground="#8390A1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,10,0">
                        <Border x:Name="AccessBadge" Background="#EAF8F2" CornerRadius="9" Padding="9,5"
                                Margin="0,0,6,0" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#25A46C" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="AccessStatusText" Text="会话目录已启用" FontSize="11.5" Foreground="#2F7E60"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="PopoutButton" Style="{StaticResource IconButton}" ToolTip="弹出 Dashboard"
                                Click="Popout_Click" Visibility="Collapsed">
                            <Viewbox Width="17" Height="17"><Path Style="{StaticResource ButtonIconPath}" Data="M14,4 H20 V10 M20,4 L11,13 M18,13 V20 H4 V6 H11"/></Viewbox>
                        </Button>
                        <Button x:Name="FullscreenButton" Style="{StaticResource IconButton}" ToolTip="全屏"
                                Click="Fullscreen_Click" Visibility="Collapsed">
                            <Viewbox Width="17" Height="17"><Path Style="{StaticResource ButtonIconPath}" Data="M9,4 H4 V9 M15,4 H20 V9 M20,15 V20 H15 M9,20 H4 V15"/></Viewbox>
                        </Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="命令面板" Click="CommandButton_Click">
                            <Viewbox Width="17" Height="17"><Path Style="{StaticResource ButtonIconPath}" Data="M10.5,4 C6.9,4 4,6.9 4,10.5 C4,14.1 6.9,17 10.5,17 C14.1,17 17,14.1 17,10.5 C17,6.9 14.1,4 10.5,4 Z M15.3,15.3 L20,20"/></Viewbox>
                        </Button>
                    </StackPanel>
                    <ProgressBar x:Name="NavigationProgress" Grid.ColumnSpan="3" Height="2" VerticalAlignment="Bottom"
                                 IsIndeterminate="True" Foreground="#4285F4" Visibility="Collapsed"/>
                </Grid>

                <Grid Grid.Row="1" x:Name="ContentGrid" Background="#F7F9FC">
                    <ScrollViewer x:Name="HomeView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="22">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="个人工作台" FontSize="23" FontWeight="SemiBold"/>
                                    <TextBlock Text="项目、资料、开发环境和 Cloudflare Dashboard 的统一入口。" FontSize="13.5" Foreground="#6B7A90" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#EDF4FF" CornerRadius="10" Padding="10,6" VerticalAlignment="Top">
                                    <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#31B675" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="本地工作台已就绪" FontSize="11.5" Foreground="#356A55"/></StackPanel>
                                </Border>
                            </Grid>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Height="176" Style="{StaticResource HomeCard}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" Background="#EAF2FF" CornerRadius="11"><Viewbox Width="21" Height="21"><Path Data="M6,18 H18 C20.2,18 22,16.2 22,14 C22,11.8 20.2,10 18,10 C17.4,6.6 14.5,4 11,4 C7.8,4 5.1,6.2 4.3,9.2 C2.4,9.8 1,11.6 1,13.7 C1,16.1 3,18 6,18 Z" Stroke="#4285F4" StrokeThickness="1.8" StrokeLineJoin="Round" Fill="Transparent"/></Viewbox></Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Cloudflare Dashboard" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="主窗口内嵌 · Access 会话持久化" FontSize="11.5" Foreground="#728197" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                                            <Border Grid.Column="2" Background="#EAF8F2" CornerRadius="8" Padding="8,4"><TextBlock Text="已接入" FontSize="10.5" Foreground="#27805C"/></Border>
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="在主窗口内直接使用 Dashboard，Cloudflare Access 登录状态由本机长期保存。" FontSize="12.5" Foreground="#65758B" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                        <Button Grid.Row="2" Content="打开 Dashboard" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="OpenDashboard_Click"/>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="2" Height="176" Style="{StaticResource HomeCard}">
                                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" Background="#F0ECFF" CornerRadius="11"><Viewbox Width="21" Height="21"><Path Data="M4,5 H20 V19 H4 Z M7,9 L10,12 L7,15 M12,15 H17" Stroke="#7564E8" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/></Viewbox></Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="开发环境" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="工作区模块待接入" FontSize="11.5" Foreground="#728197" Margin="0,2,0,0"/></StackPanel>
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="Python、终端、Git、Codex 和 Gemini 将按工作区统一组织。" FontSize="12.5" Foreground="#65758B" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                        <Border Grid.Row="2" Background="#F1F3F8" CornerRadius="9" Padding="12,7" HorizontalAlignment="Left"><TextBlock Text="即将接入" FontSize="12" Foreground="#7C8799"/></Border>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="4" Height="176" Style="{StaticResource HomeCard}">
                                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" Background="#E9F8F8" CornerRadius="11"><Viewbox Width="21" Height="21"><Path Data="M5,4 H16 C18,4 19,5 19,7 V20 H8 C6,20 5,19 5,17 Z M5,17 C6,16 7,16 8,16 H19 M8,8 H16 M8,12 H16" Stroke="#249AA8" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/></Viewbox></Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="资料库" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Zotero 只读模块待接入" FontSize="11.5" Foreground="#728197" Margin="0,2,0,0"/></StackPanel>
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="Zotero 只读检索、PDF 阅读与 Markdown 笔记将集中在这里。" FontSize="12.5" Foreground="#65758B" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                        <Border Grid.Row="2" Background="#F1F3F8" CornerRadius="9" Padding="12,7" HorizontalAlignment="Left"><TextBlock Text="即将接入" FontSize="12" Foreground="#7C8799"/></Border>
                                    </Grid>
                                </Border>
                            </Grid>
                            <Border Grid.Row="4" Background="White" BorderBrush="#E1E8F1" BorderThickness="1" CornerRadius="14" Padding="16">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="2,0,16,0"><TextBlock Text="当前阶段" FontSize="11" Foreground="#8591A2"/><TextBlock Text="桌面骨架已就位" FontSize="13.5" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="先保证入口、窗口与基础交互稳定。" FontSize="11.5" Foreground="#748296" Margin="0,3,0,0"/></StackPanel>
                                    <Border Grid.Column="1" Background="#E7ECF3" Margin="0,1"/>
                                    <StackPanel Grid.Column="2" Margin="16,0"><TextBlock Text="Dashboard" FontSize="11" Foreground="#8591A2"/><TextBlock Text="已完成原生内嵌" FontSize="13.5" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="Access 登录与会话保持正常。" FontSize="11.5" Foreground="#748296" Margin="0,3,0,0"/></StackPanel>
                                    <Border Grid.Column="3" Background="#E7ECF3" Margin="0,1"/>
                                    <StackPanel Grid.Column="4" Margin="16,0,2,0"><TextBlock Text="下一步" FontSize="11" Foreground="#8591A2"/><TextBlock Text="工作区与资料库" FontSize="13.5" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="逐项接入真实的本地能力。" FontSize="11.5" Foreground="#748296" Margin="0,3,0,0"/></StackPanel>
