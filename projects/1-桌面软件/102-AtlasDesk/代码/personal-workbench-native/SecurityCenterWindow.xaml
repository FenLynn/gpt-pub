<Window x:Class="PersonalWorkbench.SecurityCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AtlasDesk 安全与隐私" Width="760" Height="700" MinWidth="700" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="#F4F7FB" FontFamily="{StaticResource AppFont}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="安全与隐私" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="OverallStatusText" FontSize="12.2" Foreground="#66778D" Margin="0,4,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#EAF2FF" CornerRadius="9" Padding="10,6" VerticalAlignment="Center">
                <TextBlock Text="Runtime 不保存私人数据" Foreground="#326FD6" FontSize="11.5"/>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border x:Name="SetupPanel" Style="{StaticResource SurfaceCard}" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="建立加密保险库" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="主密码至少 20 位，建议保存在 Bitwarden；TOTP 二维码使用 Google Authenticator 扫描。主密码不会写入电脑。" FontSize="11.8" Foreground="#718197" TextWrapping="Wrap" Margin="0,5,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="主密码" Style="{StaticResource SectionHeading}" VerticalAlignment="Center"/>
                            <PasswordBox x:Name="SetupPasswordBox" Grid.Column="1" Height="34" Padding="8,4"/>
                            <TextBlock Grid.Row="2" Text="确认主密码" Style="{StaticResource SectionHeading}" VerticalAlignment="Center"/>
                            <PasswordBox x:Name="SetupConfirmBox" Grid.Row="2" Grid.Column="1" Height="34" Padding="8,4"/>
                            <Button Grid.Row="4" Grid.Column="1" Content="生成 TOTP 二维码" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="GenerateQr_Click"/>
                        </Grid>

                        <Border x:Name="QrPanel" Visibility="Collapsed" Background="#F8FAFD" BorderBrush="#E0E7F0" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,16,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Background="White" BorderBrush="#DFE6EF" BorderThickness="1" CornerRadius="10" Padding="10">
                                    <Image x:Name="TotpQrImage" Width="200" Height="200" Stretch="Uniform"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                    <TextBlock Text="1. 用 Google Authenticator 扫码" FontWeight="SemiBold" FontSize="12.5"/>
                                    <TextBlock Text="无法扫码时，可手动输入下面的密钥。" FontSize="11.5" Foreground="#718197" Margin="0,4,0,8"/>
                                    <TextBox x:Name="TotpSecretBox" IsReadOnly="True" TextWrapping="Wrap" Height="58" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="2. 输入手机当前显示的 6 位验证码" FontWeight="SemiBold" FontSize="12.5" Margin="0,14,0,6"/>
                                    <TextBox x:Name="SetupTotpCodeBox" MaxLength="6" Width="150" Height="34" HorizontalAlignment="Left"/>
                                    <Button Content="确认并启用" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="CompleteSetup_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="SetupStatusText" FontSize="11.5" Foreground="#A14D40" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border x:Name="VaultPanel" Style="{StaticResource SurfaceCard}" Padding="18" Margin="0,0,0,12" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="加密保险库" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="普通使用 AtlasDesk 不需要解锁；只有查看或修改加密数据时才输入主密码和 TOTP。" FontSize="11.8" Foreground="#718197" TextWrapping="Wrap" Margin="0,5,0,14"/>
                        <Grid x:Name="VaultLockedPanel">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="主密码" Style="{StaticResource SectionHeading}" VerticalAlignment="Center"/>
                            <PasswordBox x:Name="UnlockPasswordBox" Grid.Column="1" Height="34" Padding="8,4"/>
                            <TextBlock Grid.Row="2" Text="TOTP 验证码" Style="{StaticResource SectionHeading}" VerticalAlignment="Center"/>
                            <TextBox x:Name="UnlockTotpBox" Grid.Row="2" Grid.Column="1" Width="150" Height="34" HorizontalAlignment="Left" MaxLength="6"/>
                            <Button Grid.Row="4" Grid.Column="1" Content="解锁保险库" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="Unlock_Click"/>
                        </Grid>
                        <StackPanel x:Name="VaultUnlockedPanel" Visibility="Collapsed">
                            <Border Background="#E8F7F0" CornerRadius="10" Padding="12">
                                <TextBlock Text="保险库已在本次程序运行中解锁。退出 AtlasDesk 后会清除内存中的解密密钥。" Foreground="#23735A" TextWrapping="Wrap"/>
                            </Border>
                            <WrapPanel Margin="0,14,0,0">
                                <Button Content="打开加密数据" Style="{StaticResource PrimaryButton}" Click="OpenVault_Click"/>
                                <Button Content="锁定保险库" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="LockVault_Click"/>
                            </WrapPanel>
                        </StackPanel>
                        <TextBlock x:Name="VaultStatusText" FontSize="11.5" Foreground="#A14D40" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SurfaceCard}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="可选四位临时锁" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="它只用于你主动离开电脑时临时遮挡界面，不参与任何数据加密。可以随时关闭，默认不自动锁定。" FontSize="11.8" Foreground="#718197" TextWrapping="Wrap" Margin="0,5,0,14"/>
                        <TextBlock x:Name="PinStatusText" FontSize="12.2" FontWeight="SemiBold" Foreground="#53657C" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/><ColumnDefinition Width="12"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="新四位密码" Style="{StaticResource SectionHeading}" VerticalAlignment="Center"/>
                            <PasswordBox x:Name="NewPinBox" Grid.Column="1" MaxLength="4" Height="34" Padding="8,4"/>
                            <PasswordBox x:Name="ConfirmPinBox" Grid.Column="3" MaxLength="4" Height="34" Padding="8,4" ToolTip="再次输入"/>
                            <Button Grid.Column="4" Content="设置 / 修改" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" HorizontalAlignment="Left" Click="SetPin_Click"/>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="当前四位密码" Style="{StaticResource SectionHeading}" VerticalAlignment="Center"/>
                            <PasswordBox x:Name="CurrentPinBox" Grid.Column="1" MaxLength="4" Height="34" Padding="8,4"/>
                            <WrapPanel Grid.Column="2" Margin="10,0,0,0">
                                <Button Content="关闭临时锁" Style="{StaticResource SecondaryButton}" Click="DisablePin_Click"/>
                                <Button Content="立即锁定" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="LockNow_Click"/>
                            </WrapPanel>
                        </Grid>
                        <TextBlock x:Name="PinOperationStatusText" FontSize="11.5" Foreground="#A14D40" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="私人数据位于 AppData；AtlasDesk 程序文件夹只包含可公开 Runtime。" FontSize="11.2" Foreground="#7D8A9B" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="关闭" Style="{StaticResource SecondaryButton}" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
